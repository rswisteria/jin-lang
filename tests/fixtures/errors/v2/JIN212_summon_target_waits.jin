{
  "$schema": "https://xtone.internal/jin/schemas/jin-v2.schema.json",
  "version": 2,
  "root": "Main",
  "stage": {
    "width": 64,
    "height": 64
  },
  "circles": [
    {
      "name": "Main",
      "core": "main",
      "sigils": [
        {
          "name": "slow",
          "kind": "summon",
          "circle": "Lib",
          "rite": "slow"
        }
      ],
      "rites": [
        {
          "name": "main",
          "steps": [
            {
              "do": "cast",
              "target": "slow"
            }
          ]
        }
      ]
    },
    {
      "name": "Lib",
      "core": "main",
      "rites": [
        {
          "name": "main",
          "steps": []
        },
        {
          "name": "slow",
          "steps": [
            {
              "do": "wait",
              "ticks": "1"
            }
          ]
        }
      ]
    }
  ]
}
