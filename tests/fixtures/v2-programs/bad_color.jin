{
  "$schema": "https://xtone.internal/jin/schemas/jin-v2.schema.json",
  "version": 2,
  "root": "Only",
  "stage": {
    "width": 64,
    "height": 64
  },
  "circles": [
    {
      "name": "Only",
      "core": "start",
      "sigils": [
        {
          "name": "canvas",
          "kind": "host",
          "host": "canvas"
        }
      ],
      "rites": [
        {
          "name": "start",
          "steps": []
        },
        {
          "name": "step",
          "steps": [
            {
              "do": "cast",
              "target": "canvas.clear",
              "args": [
                "\"re\" ++ \"d\""
              ]
            }
          ]
        }
      ],
      "boundary": {
        "on": [
          {
            "event": "tick",
            "rite": "step"
          }
        ]
      }
    }
  ]
}
