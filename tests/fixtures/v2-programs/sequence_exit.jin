{
  "$schema": "https://xtone.internal/jin/schemas/jin-v2.schema.json",
  "version": 2,
  "root": "Seq",
  "stage": {
    "width": 64,
    "height": 64
  },
  "circles": [
    {
      "name": "Seq",
      "flow": {
        "kind": "sequence",
        "steps": [
          "First",
          "Second"
        ]
      }
    },
    {
      "name": "First",
      "core": "main",
      "rites": [
        {
          "name": "main",
          "steps": [
            {
              "do": "finish"
            }
          ]
        }
      ]
    },
    {
      "name": "Second",
      "core": "start",
      "state": [
        {
          "name": "n",
          "type": "num",
          "init": "0",
          "out": true
        }
      ],
      "rites": [
        {
          "name": "start",
          "steps": []
        },
        {
          "name": "step",
          "steps": [
            {
              "do": "set",
              "target": "n",
              "expr": "n + 1"
            },
            {
              "do": "if",
              "cond": "n == 2",
              "then": [
                {
                  "do": "finish"
                }
              ]
            }
          ]
        },
        {
          "name": "bye",
          "steps": [
            {
              "do": "set",
              "target": "n",
              "expr": "n + 100"
            }
          ]
        }
      ],
      "boundary": {
        "on": [
          {
            "event": "tick",
            "rite": "step"
          },
          {
            "event": "exit",
            "rite": "bye"
          }
        ]
      }
    }
  ]
}
