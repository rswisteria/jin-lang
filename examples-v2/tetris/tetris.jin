{
  "$schema": "https://xtone.internal/jin/schemas/jin-v2.schema.json",
  "version": 2,
  "root": "Game",
  "stage": {
    "width": 176,
    "height": 176,
    "fps": 30,
    "seed": 3
  },
  "forms": [
    {
      "name": "Piece",
      "fields": [
        {
          "name": "kind",
          "type": "num"
        },
        {
          "name": "rot",
          "type": "num"
        },
        {
          "name": "x",
          "type": "num"
        },
        {
          "name": "y",
          "type": "num"
        }
      ]
    }
  ],
  "circles": [
    {
      "name": "Game",
      "flow": {
        "kind": "loop",
        "steps": [
          "Play",
          "Result"
        ],
        "exit": "Result.quit"
      }
    },
    {
      "name": "Play",
      "core": "begin",
      "state": [
        {
          "name": "board",
          "type": "list<num>",
          "init": "[]",
          "out": true
        },
        {
          "name": "piece",
          "type": "Piece",
          "init": "Piece{kind: 0, rot: 0, x: 3, y: 0}",
          "out": true
        },
        {
          "name": "next",
          "type": "num",
          "init": "0"
        },
        {
          "name": "score",
          "type": "num",
          "init": "0",
          "out": true
        },
        {
          "name": "lines",
          "type": "num",
          "init": "0",
          "out": true
        },
        {
          "name": "placed",
          "type": "num",
          "init": "0",
          "out": true
        },
        {
          "name": "speed",
          "type": "num",
          "init": "15"
        },
        {
          "name": "soft",
          "type": "num",
          "init": "0"
        },
        {
          "name": "over",
          "type": "bool",
          "init": "false"
        },
        {
          "name": "shapes",
          "type": "list<num>",
          "init": "[0, 1, 1, 1, 2, 1, 3, 1, 2, 0, 2, 1, 2, 2, 2, 3, 0, 2, 1, 2, 2, 2, 3, 2, 1, 0, 1, 1, 1, 2, 1, 3, 1, 0, 1, 1, 2, 0, 2, 1, 2, 1, 2, 2, 3, 1, 3, 2, 1, 2, 1, 3, 2, 2, 2, 3, 0, 1, 0, 2, 1, 1, 1, 2, 0, 1, 1, 0, 1, 1, 2, 1, 1, 0, 1, 1, 1, 2, 2, 1, 0, 1, 1, 1, 1, 2, 2, 1, 0, 1, 1, 0, 1, 1, 1, 2, 0, 1, 1, 0, 1, 1, 2, 0, 1, 0, 1, 1, 2, 1, 2, 2, 0, 2, 1, 1, 1, 2, 2, 1, 0, 0, 0, 1, 1, 1, 1, 2, 0, 0, 1, 0, 1, 1, 2, 1, 1, 1, 1, 2, 2, 0, 2, 1, 0, 1, 1, 1, 1, 2, 2, 2, 0, 1, 0, 2, 1, 0, 1, 1, 0, 0, 0, 1, 1, 1, 2, 1, 1, 0, 1, 1, 1, 2, 2, 0, 0, 1, 1, 1, 2, 1, 2, 2, 0, 2, 1, 0, 1, 1, 1, 2, 0, 1, 1, 1, 2, 0, 2, 1, 1, 0, 1, 1, 1, 2, 2, 2, 0, 1, 0, 2, 1, 1, 2, 1, 0, 0, 1, 0, 1, 1, 1, 2]"
        },
        {
          "name": "colors",
          "type": "list<str>",
          "init": "[\"#4ce0e6\", \"#f2d541\", \"#b26ce8\", \"#5fd463\", \"#ef5b5b\", \"#4f7be8\", \"#f2953d\"]"
        }
      ],
      "sigils": [
        {
          "name": "canvas",
          "kind": "host",
          "host": "canvas"
        },
        {
          "name": "input",
          "kind": "host",
          "host": "input"
        },
        {
          "name": "audio",
          "kind": "host",
          "host": "audio"
        },
        {
          "name": "random",
          "kind": "host",
          "host": "random"
        }
      ],
      "rites": [
        {
          "name": "begin",
          "steps": [
            {
              "do": "set",
              "target": "score",
              "expr": "0"
            },
            {
              "do": "set",
              "target": "lines",
              "expr": "0"
            },
            {
              "do": "set",
              "target": "placed",
              "expr": "0"
            },
            {
              "do": "set",
              "target": "speed",
              "expr": "15"
            },
            {
              "do": "set",
              "target": "over",
              "expr": "false"
            },
            {
              "do": "set",
              "target": "soft",
              "expr": "0"
            },
            {
              "do": "cast",
              "target": "clear",
              "args": [
                "board"
              ]
            },
            {
              "do": "loop",
              "kind": "count",
              "name": "i",
              "times": "200",
              "steps": [
                {
                  "do": "cast",
                  "target": "push",
                  "args": [
                    "board",
                    "0"
                  ]
                }
              ]
            },
            {
              "do": "set",
              "target": "next",
              "expr": "random.range(0, 6)"
            },
            {
              "do": "cast",
              "target": "spawn"
            },
            {
              "do": "loop",
              "kind": "while",
              "cond": "not over",
              "steps": [
                {
                  "do": "wait",
                  "ticks": "speed"
                },
                {
                  "do": "let",
                  "name": "ok",
                  "expr": "false"
                },
                {
                  "do": "cast",
                  "target": "fits",
                  "args": [
                    "piece.kind",
                    "piece.rot",
                    "piece.x",
                    "piece.y + 1"
                  ],
                  "into": "ok"
                },
                {
                  "do": "if",
                  "cond": "ok",
                  "then": [
                    {
                      "do": "set",
                      "target": "piece.y",
                      "expr": "piece.y + 1"
                    }
                  ],
                  "else": [
                    {
                      "do": "cast",
                      "target": "lock"
                    }
                  ]
                }
              ]
            },
            {
              "do": "finish"
            }
          ]
        },
        {
          "name": "fits",
          "params": [
            {
              "name": "kind",
              "type": "num"
            },
            {
              "name": "rot",
              "type": "num"
            },
            {
              "name": "x",
              "type": "num"
            },
            {
              "name": "y",
              "type": "num"
            }
          ],
          "returns": "bool",
          "steps": [
            {
              "do": "loop",
              "kind": "count",
              "name": "i",
              "times": "4",
              "steps": [
                {
                  "do": "let",
                  "name": "cx",
                  "expr": "x + shapes[((kind * 4 + rot) * 4 + i) * 2]"
                },
                {
                  "do": "let",
                  "name": "cy",
                  "expr": "y + shapes[((kind * 4 + rot) * 4 + i) * 2 + 1]"
                },
                {
                  "do": "if",
                  "cond": "cx < 0 or cx >= 10 or cy >= 20",
                  "then": [
                    {
                      "do": "return",
                      "expr": "false"
                    }
                  ]
                },
                {
                  "do": "if",
                  "cond": "cy >= 0 and board[cy * 10 + cx] != 0",
                  "then": [
                    {
                      "do": "return",
                      "expr": "false"
                    }
                  ]
                }
              ]
            },
            {
              "do": "return",
              "expr": "true"
            }
          ]
        },
        {
          "name": "spawn",
          "steps": [
            {
              "do": "set",
              "target": "piece",
              "expr": "Piece{kind: next, rot: 0, x: 3, y: 0}"
            },
            {
              "do": "set",
              "target": "next",
              "expr": "random.range(0, 6)"
            },
            {
              "do": "let",
              "name": "ok",
              "expr": "false"
            },
            {
              "do": "cast",
              "target": "fits",
              "args": [
                "piece.kind",
                "piece.rot",
                "piece.x",
                "piece.y"
              ],
              "into": "ok"
            },
            {
              "do": "if",
              "cond": "not ok",
              "then": [
                {
                  "do": "set",
                  "target": "over",
                  "expr": "true"
                }
              ]
            }
          ]
        },
        {
          "name": "lock",
          "steps": [
            {
              "do": "let",
              "name": "kind",
              "expr": "piece.kind"
            },
            {
              "do": "let",
              "name": "rot",
              "expr": "piece.rot"
            },
            {
              "do": "loop",
              "kind": "count",
              "name": "i",
              "times": "4",
              "steps": [
                {
                  "do": "let",
                  "name": "cx",
                  "expr": "piece.x + shapes[((kind * 4 + rot) * 4 + i) * 2]"
                },
                {
                  "do": "let",
                  "name": "cy",
                  "expr": "piece.y + shapes[((kind * 4 + rot) * 4 + i) * 2 + 1]"
                },
                {
                  "do": "if",
                  "cond": "cy >= 0",
                  "then": [
                    {
                      "do": "set",
                      "target": "board[cy * 10 + cx]",
                      "expr": "kind + 1"
                    }
                  ]
                }
              ]
            },
            {
              "do": "cast",
              "target": "audio.tone",
              "args": [
                "220",
                "30"
              ]
            },
            {
              "do": "cast",
              "target": "clearLines"
            },
            {
              "do": "set",
              "target": "placed",
              "expr": "placed + 1"
            },
            {
              "do": "cast",
              "target": "spawn"
            }
          ]
        },
        {
          "name": "clearLines",
          "steps": [
            {
              "do": "let",
              "name": "cleared",
              "expr": "0"
            },
            {
              "do": "loop",
              "kind": "count",
              "name": "r",
              "times": "20",
              "steps": [
                {
                  "do": "let",
                  "name": "full",
                  "expr": "true"
                },
                {
                  "do": "loop",
                  "kind": "count",
                  "name": "c",
                  "times": "10",
                  "steps": [
                    {
                      "do": "if",
                      "cond": "board[r * 10 + c] == 0",
                      "then": [
                        {
                          "do": "set",
                          "target": "full",
                          "expr": "false"
                        }
                      ]
                    }
                  ]
                },
                {
                  "do": "if",
                  "cond": "full",
                  "then": [
                    {
                      "do": "loop",
                      "kind": "count",
                      "name": "k",
                      "times": "r * 10",
                      "steps": [
                        {
                          "do": "let",
                          "name": "i",
                          "expr": "r * 10 - 1 - k"
                        },
                        {
                          "do": "set",
                          "target": "board[i + 10]",
                          "expr": "board[i]"
                        }
                      ]
                    },
                    {
                      "do": "loop",
                      "kind": "count",
                      "name": "c2",
                      "times": "10",
                      "steps": [
                        {
                          "do": "set",
                          "target": "board[c2]",
                          "expr": "0"
                        }
                      ]
                    },
                    {
                      "do": "set",
                      "target": "cleared",
                      "expr": "cleared + 1"
                    }
                  ]
                }
              ]
            },
            {
              "do": "if",
              "cond": "cleared > 0",
              "then": [
                {
                  "do": "let",
                  "name": "bonus",
                  "expr": "[0, 100, 300, 500, 800]"
                },
                {
                  "do": "set",
                  "target": "score",
                  "expr": "score + bonus[cleared]"
                },
                {
                  "do": "set",
                  "target": "lines",
                  "expr": "lines + cleared"
                },
                {
                  "do": "set",
                  "target": "speed",
                  "expr": "max(4, 15 - floor(lines / 5))"
                },
                {
                  "do": "cast",
                  "target": "audio.tone",
                  "args": [
                    "660",
                    "80"
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "control",
          "steps": [
            {
              "do": "if",
              "cond": "over",
              "then": [
                {
                  "do": "return"
                }
              ]
            },
            {
              "do": "let",
              "name": "ok",
              "expr": "false"
            },
            {
              "do": "if",
              "cond": "input.pressed(\"ArrowLeft\")",
              "then": [
                {
                  "do": "cast",
                  "target": "fits",
                  "args": [
                    "piece.kind",
                    "piece.rot",
                    "piece.x - 1",
                    "piece.y"
                  ],
                  "into": "ok"
                },
                {
                  "do": "if",
                  "cond": "ok",
                  "then": [
                    {
                      "do": "set",
                      "target": "piece.x",
                      "expr": "piece.x - 1"
                    }
                  ]
                }
              ]
            },
            {
              "do": "if",
              "cond": "input.pressed(\"ArrowRight\")",
              "then": [
                {
                  "do": "cast",
                  "target": "fits",
                  "args": [
                    "piece.kind",
                    "piece.rot",
                    "piece.x + 1",
                    "piece.y"
                  ],
                  "into": "ok"
                },
                {
                  "do": "if",
                  "cond": "ok",
                  "then": [
                    {
                      "do": "set",
                      "target": "piece.x",
                      "expr": "piece.x + 1"
                    }
                  ]
                }
              ]
            },
            {
              "do": "if",
              "cond": "input.pressed(\"ArrowUp\")",
              "then": [
                {
                  "do": "let",
                  "name": "r",
                  "expr": "(piece.rot + 1) % 4"
                },
                {
                  "do": "cast",
                  "target": "fits",
                  "args": [
                    "piece.kind",
                    "r",
                    "piece.x",
                    "piece.y"
                  ],
                  "into": "ok"
                },
                {
                  "do": "if",
                  "cond": "ok",
                  "then": [
                    {
                      "do": "set",
                      "target": "piece.rot",
                      "expr": "r"
                    }
                  ]
                }
              ]
            },
            {
              "do": "if",
              "cond": "input.key(\"ArrowDown\")",
              "then": [
                {
                  "do": "set",
                  "target": "soft",
                  "expr": "soft + 1"
                },
                {
                  "do": "if",
                  "cond": "soft % 3 == 0",
                  "then": [
                    {
                      "do": "cast",
                      "target": "fall"
                    }
                  ]
                }
              ]
            },
            {
              "do": "if",
              "cond": "input.pressed(\"Space\")",
              "then": [
                {
                  "do": "cast",
                  "target": "hardDrop"
                }
              ]
            },
            {
              "do": "cast",
              "target": "paintBoard"
            },
            {
              "do": "cast",
              "target": "paintPanel"
            }
          ]
        },
        {
          "name": "fall",
          "steps": [
            {
              "do": "let",
              "name": "ok",
              "expr": "false"
            },
            {
              "do": "cast",
              "target": "fits",
              "args": [
                "piece.kind",
                "piece.rot",
                "piece.x",
                "piece.y + 1"
              ],
              "into": "ok"
            },
            {
              "do": "if",
              "cond": "ok",
              "then": [
                {
                  "do": "set",
                  "target": "piece.y",
                  "expr": "piece.y + 1"
                }
              ]
            }
          ]
        },
        {
          "name": "hardDrop",
          "steps": [
            {
              "do": "let",
              "name": "ok",
              "expr": "false"
            },
            {
              "do": "loop",
              "kind": "while",
              "cond": "true",
              "steps": [
                {
                  "do": "cast",
                  "target": "fits",
                  "args": [
                    "piece.kind",
                    "piece.rot",
                    "piece.x",
                    "piece.y + 1"
                  ],
                  "into": "ok"
                },
                {
                  "do": "if",
                  "cond": "not ok",
                  "then": [
                    {
                      "do": "break"
                    }
                  ]
                },
                {
                  "do": "set",
                  "target": "piece.y",
                  "expr": "piece.y + 1"
                }
              ]
            },
            {
              "do": "cast",
              "target": "lock"
            }
          ]
        },
        {
          "name": "paintBoard",
          "steps": [
            {
              "do": "cast",
              "target": "canvas.clear",
              "args": [
                "\"#101418\""
              ]
            },
            {
              "do": "cast",
              "target": "canvas.ink",
              "args": [
                "\"#2a3340\""
              ]
            },
            {
              "do": "cast",
              "target": "canvas.rect",
              "args": [
                "6",
                "6",
                "84",
                "164"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.ink",
              "args": [
                "\"#000\""
              ]
            },
            {
              "do": "cast",
              "target": "canvas.rect",
              "args": [
                "8",
                "8",
                "80",
                "160"
              ]
            },
            {
              "do": "loop",
              "kind": "count",
              "name": "i",
              "times": "200",
              "steps": [
                {
                  "do": "let",
                  "name": "v",
                  "expr": "board[i]"
                },
                {
                  "do": "if",
                  "cond": "v != 0",
                  "then": [
                    {
                      "do": "cast",
                      "target": "canvas.ink",
                      "args": [
                        "colors[v - 1]"
                      ]
                    },
                    {
                      "do": "cast",
                      "target": "canvas.rect",
                      "args": [
                        "8 + i % 10 * 8",
                        "8 + floor(i / 10) * 8",
                        "7",
                        "7"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "do": "let",
              "name": "kind",
              "expr": "piece.kind"
            },
            {
              "do": "let",
              "name": "rot",
              "expr": "piece.rot"
            },
            {
              "do": "cast",
              "target": "canvas.ink",
              "args": [
                "colors[kind]"
              ]
            },
            {
              "do": "loop",
              "kind": "count",
              "name": "j",
              "times": "4",
              "steps": [
                {
                  "do": "let",
                  "name": "cx",
                  "expr": "piece.x + shapes[((kind * 4 + rot) * 4 + j) * 2]"
                },
                {
                  "do": "let",
                  "name": "cy",
                  "expr": "piece.y + shapes[((kind * 4 + rot) * 4 + j) * 2 + 1]"
                },
                {
                  "do": "if",
                  "cond": "cy >= 0",
                  "then": [
                    {
                      "do": "cast",
                      "target": "canvas.rect",
                      "args": [
                        "8 + cx * 8",
                        "8 + cy * 8",
                        "7",
                        "7"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "paintPanel",
          "steps": [
            {
              "do": "cast",
              "target": "canvas.ink",
              "args": [
                "\"#c8d0dc\""
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "\"SCORE\"",
                "100",
                "8"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "str(score)",
                "100",
                "18"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "\"LINES\"",
                "100",
                "36"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "str(lines)",
                "100",
                "46"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "\"NEXT\"",
                "100",
                "64"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.ink",
              "args": [
                "colors[next]"
              ]
            },
            {
              "do": "loop",
              "kind": "count",
              "name": "i",
              "times": "4",
              "steps": [
                {
                  "do": "cast",
                  "target": "canvas.rect",
                  "args": [
                    "100 + shapes[(next * 16 + i) * 2] * 8",
                    "76 + shapes[(next * 16 + i) * 2 + 1] * 8",
                    "7",
                    "7"
                  ]
                }
              ]
            }
          ]
        }
      ],
      "boundary": {
        "on": [
          {
            "event": "tick",
            "rite": "control"
          }
        ],
        "guards": [
          {
            "assert": "len(board) == 0 or len(board) == 200",
            "message": "盤面は 10 × 20"
          },
          {
            "assert": "score >= 0 and lines >= 0",
            "message": "得点と消した行数は負にならない"
          }
        ]
      }
    },
    {
      "name": "Result",
      "core": "show",
      "state": [
        {
          "name": "quit",
          "type": "bool",
          "init": "false",
          "out": true
        }
      ],
      "sigils": [
        {
          "name": "canvas",
          "kind": "host",
          "host": "canvas"
        },
        {
          "name": "ui",
          "kind": "host",
          "host": "ui"
        }
      ],
      "rites": [
        {
          "name": "show",
          "steps": [
            {
              "do": "set",
              "target": "quit",
              "expr": "false"
            },
            {
              "do": "wait",
              "ticks": "20"
            }
          ]
        },
        {
          "name": "menu",
          "steps": [
            {
              "do": "cast",
              "target": "canvas.clear",
              "args": [
                "\"#101418\""
              ]
            },
            {
              "do": "cast",
              "target": "canvas.ink",
              "args": [
                "\"#3a4250\""
              ]
            },
            {
              "do": "loop",
              "kind": "count",
              "name": "i",
              "times": "200",
              "steps": [
                {
                  "do": "if",
                  "cond": "Play.board[i] != 0",
                  "then": [
                    {
                      "do": "cast",
                      "target": "canvas.rect",
                      "args": [
                        "8 + i % 10 * 8",
                        "8 + floor(i / 10) * 8",
                        "7",
                        "7"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "do": "cast",
              "target": "canvas.ink",
              "args": [
                "\"#c8d0dc\""
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "\"GAME OVER\"",
                "100",
                "8"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "\"SCORE\"",
                "100",
                "28"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "str(Play.score)",
                "100",
                "38"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "\"LINES\"",
                "100",
                "56"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "str(Play.lines)",
                "100",
                "66"
              ]
            },
            {
              "do": "if",
              "cond": "ui.button(\"RETRY\", 100, 96, 64, 20)",
              "then": [
                {
                  "do": "finish"
                }
              ]
            },
            {
              "do": "if",
              "cond": "ui.button(\"QUIT\", 100, 124, 64, 20)",
              "then": [
                {
                  "do": "set",
                  "target": "quit",
                  "expr": "true"
                },
                {
                  "do": "finish"
                }
              ]
            }
          ]
        }
      ],
      "boundary": {
        "on": [
          {
            "event": "tick",
            "rite": "menu"
          }
        ]
      }
    }
  ]
}
