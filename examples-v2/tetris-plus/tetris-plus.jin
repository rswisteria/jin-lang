{
  "$schema": "https://xtone.internal/jin/schemas/jin-v2.schema.json",
  "version": 2,
  "root": "Game",
  "stage": {
    "width": 200,
    "height": 176,
    "fps": 30,
    "seed": 7
  },
  "forms": [
    {
      "name": "Piece",
      "fields": [
        {
          "name": "kind",
          "type": "num"
        },
        {
          "name": "rot",
          "type": "num"
        },
        {
          "name": "x",
          "type": "num"
        },
        {
          "name": "y",
          "type": "num"
        }
      ]
    }
  ],
  "circles": [
    {
      "name": "Game",
      "flow": {
        "kind": "loop",
        "steps": [
          "Play",
          "Result"
        ],
        "exit": "Result.quit"
      }
    },
    {
      "name": "Play",
      "core": "begin",
      "state": [
        {
          "name": "piece",
          "type": "Piece",
          "init": "Piece{kind: 0, rot: 0, x: 3, y: 0}",
          "out": true
        },
        {
          "name": "queue",
          "type": "list<num>",
          "init": "[]"
        },
        {
          "name": "hold",
          "type": "num",
          "init": "-1"
        },
        {
          "name": "canHold",
          "type": "bool",
          "init": "true"
        },
        {
          "name": "score",
          "type": "num",
          "init": "0",
          "out": true
        },
        {
          "name": "lines",
          "type": "num",
          "init": "0",
          "out": true
        },
        {
          "name": "level",
          "type": "num",
          "init": "0",
          "out": true
        },
        {
          "name": "best",
          "type": "num",
          "init": "0",
          "out": true
        },
        {
          "name": "record",
          "type": "bool",
          "init": "false",
          "out": true
        },
        {
          "name": "over",
          "type": "bool",
          "init": "false"
        },
        {
          "name": "paused",
          "type": "bool",
          "init": "false"
        },
        {
          "name": "soft",
          "type": "num",
          "init": "0"
        }
      ],
      "sigils": [
        {
          "name": "canvas",
          "kind": "host",
          "host": "canvas"
        },
        {
          "name": "input",
          "kind": "host",
          "host": "input"
        },
        {
          "name": "audio",
          "kind": "host",
          "host": "audio"
        },
        {
          "name": "random",
          "kind": "host",
          "host": "random"
        },
        {
          "name": "storage",
          "kind": "host",
          "host": "storage"
        },
        {
          "name": "fits",
          "kind": "summon",
          "circle": "Board",
          "rite": "fits"
        },
        {
          "name": "depth",
          "kind": "summon",
          "circle": "Board",
          "rite": "depth"
        },
        {
          "name": "place",
          "kind": "summon",
          "circle": "Board",
          "rite": "place"
        },
        {
          "name": "wipe",
          "kind": "summon",
          "circle": "Board",
          "rite": "reset"
        },
        {
          "name": "drawBoard",
          "kind": "summon",
          "circle": "Board",
          "rite": "paint"
        },
        {
          "name": "drawPiece",
          "kind": "summon",
          "circle": "Board",
          "rite": "piece"
        }
      ],
      "rites": [
        {
          "name": "begin",
          "steps": [
            {
              "do": "cast",
              "target": "reset"
            },
            {
              "do": "loop",
              "kind": "while",
              "cond": "not over",
              "steps": [
                {
                  "do": "wait",
                  "ticks": "max(2, 20 - level * 2)"
                },
                {
                  "do": "if",
                  "cond": "paused",
                  "then": [
                    {
                      "do": "wait",
                      "until": "not paused"
                    }
                  ]
                },
                {
                  "do": "cast",
                  "target": "fall",
                  "args": [
                    "false"
                  ]
                }
              ]
            },
            {
              "do": "if",
              "cond": "score > best",
              "then": [
                {
                  "do": "set",
                  "target": "record",
                  "expr": "true"
                },
                {
                  "do": "set",
                  "target": "best",
                  "expr": "score"
                },
                {
                  "do": "cast",
                  "target": "storage.set",
                  "args": [
                    "\"tetris-plus.best\"",
                    "str(best)"
                  ]
                }
              ]
            },
            {
              "do": "cast",
              "target": "audio.tone",
              "args": [
                "110",
                "300"
              ]
            },
            {
              "do": "finish"
            }
          ]
        },
        {
          "name": "reset",
          "steps": [
            {
              "do": "set",
              "target": "score",
              "expr": "0"
            },
            {
              "do": "set",
              "target": "lines",
              "expr": "0"
            },
            {
              "do": "set",
              "target": "level",
              "expr": "0"
            },
            {
              "do": "set",
              "target": "over",
              "expr": "false"
            },
            {
              "do": "set",
              "target": "paused",
              "expr": "false"
            },
            {
              "do": "set",
              "target": "record",
              "expr": "false"
            },
            {
              "do": "set",
              "target": "hold",
              "expr": "-1"
            },
            {
              "do": "set",
              "target": "canHold",
              "expr": "true"
            },
            {
              "do": "set",
              "target": "best",
              "expr": "num(storage.get(\"tetris-plus.best\"))"
            },
            {
              "do": "cast",
              "target": "wipe"
            },
            {
              "do": "cast",
              "target": "spawn"
            }
          ]
        },
        {
          "name": "spawn",
          "steps": [
            {
              "do": "if",
              "cond": "len(queue) < 7",
              "then": [
                {
                  "do": "let",
                  "name": "bag",
                  "expr": "[0, 1, 2, 3, 4, 5, 6]"
                },
                {
                  "do": "loop",
                  "kind": "count",
                  "name": "i",
                  "times": "7",
                  "steps": [
                    {
                      "do": "let",
                      "name": "j",
                      "expr": "random.range(0, len(bag) - 1)"
                    },
                    {
                      "do": "cast",
                      "target": "push",
                      "args": [
                        "queue",
                        "bag[j]"
                      ]
                    },
                    {
                      "do": "cast",
                      "target": "removeAt",
                      "args": [
                        "bag",
                        "j"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "do": "let",
              "name": "k",
              "expr": "queue[0]"
            },
            {
              "do": "cast",
              "target": "removeAt",
              "args": [
                "queue",
                "0"
              ]
            },
            {
              "do": "cast",
              "target": "enter",
              "args": [
                "k"
              ]
            }
          ]
        },
        {
          "name": "enter",
          "params": [
            {
              "name": "k",
              "type": "num"
            }
          ],
          "steps": [
            {
              "do": "set",
              "target": "piece",
              "expr": "Piece{kind: k, rot: 0, x: 3, y: 0}"
            },
            {
              "do": "let",
              "name": "ok",
              "expr": "false"
            },
            {
              "do": "cast",
              "target": "fits",
              "args": [
                "k",
                "0",
                "3",
                "0"
              ],
              "into": "ok"
            },
            {
              "do": "if",
              "cond": "not ok",
              "then": [
                {
                  "do": "set",
                  "target": "over",
                  "expr": "true"
                }
              ]
            }
          ]
        },
        {
          "name": "fall",
          "params": [
            {
              "name": "bySoft",
              "type": "bool"
            }
          ],
          "steps": [
            {
              "do": "let",
              "name": "ok",
              "expr": "false"
            },
            {
              "do": "cast",
              "target": "fits",
              "args": [
                "piece.kind",
                "piece.rot",
                "piece.x",
                "piece.y + 1"
              ],
              "into": "ok"
            },
            {
              "do": "if",
              "cond": "ok",
              "then": [
                {
                  "do": "set",
                  "target": "piece.y",
                  "expr": "piece.y + 1"
                },
                {
                  "do": "if",
                  "cond": "bySoft",
                  "then": [
                    {
                      "do": "set",
                      "target": "score",
                      "expr": "score + 1"
                    }
                  ]
                }
              ],
              "else": [
                {
                  "do": "cast",
                  "target": "lock"
                }
              ]
            }
          ]
        },
        {
          "name": "lock",
          "steps": [
            {
              "do": "let",
              "name": "n",
              "expr": "0"
            },
            {
              "do": "cast",
              "target": "place",
              "args": [
                "piece.kind",
                "piece.rot",
                "piece.x",
                "piece.y"
              ],
              "into": "n"
            },
            {
              "do": "cast",
              "target": "audio.tone",
              "args": [
                "220",
                "30"
              ]
            },
            {
              "do": "if",
              "cond": "n > 0",
              "then": [
                {
                  "do": "let",
                  "name": "bonus",
                  "expr": "[0, 100, 300, 500, 800]"
                },
                {
                  "do": "set",
                  "target": "score",
                  "expr": "score + bonus[n] * (level + 1)"
                },
                {
                  "do": "set",
                  "target": "lines",
                  "expr": "lines + n"
                },
                {
                  "do": "set",
                  "target": "level",
                  "expr": "floor(lines / 10)"
                },
                {
                  "do": "cast",
                  "target": "audio.tone",
                  "args": [
                    "440 + n * 110",
                    "80"
                  ]
                }
              ]
            },
            {
              "do": "set",
              "target": "canHold",
              "expr": "true"
            },
            {
              "do": "cast",
              "target": "spawn"
            }
          ]
        },
        {
          "name": "control",
          "steps": [
            {
              "do": "if",
              "cond": "not over and (input.pressed(\"KeyP\") or input.pressed(\"Escape\"))",
              "then": [
                {
                  "do": "set",
                  "target": "paused",
                  "expr": "not paused"
                }
              ]
            },
            {
              "do": "cast",
              "target": "paint"
            },
            {
              "do": "if",
              "cond": "paused or over",
              "then": [
                {
                  "do": "return"
                }
              ]
            },
            {
              "do": "let",
              "name": "ok",
              "expr": "false"
            },
            {
              "do": "if",
              "cond": "input.pressed(\"ArrowLeft\")",
              "then": [
                {
                  "do": "cast",
                  "target": "fits",
                  "args": [
                    "piece.kind",
                    "piece.rot",
                    "piece.x + -1",
                    "piece.y"
                  ],
                  "into": "ok"
                },
                {
                  "do": "if",
                  "cond": "ok",
                  "then": [
                    {
                      "do": "set",
                      "target": "piece.x",
                      "expr": "piece.x + -1"
                    }
                  ]
                }
              ]
            },
            {
              "do": "if",
              "cond": "input.pressed(\"ArrowRight\")",
              "then": [
                {
                  "do": "cast",
                  "target": "fits",
                  "args": [
                    "piece.kind",
                    "piece.rot",
                    "piece.x + 1",
                    "piece.y"
                  ],
                  "into": "ok"
                },
                {
                  "do": "if",
                  "cond": "ok",
                  "then": [
                    {
                      "do": "set",
                      "target": "piece.x",
                      "expr": "piece.x + 1"
                    }
                  ]
                }
              ]
            },
            {
              "do": "if",
              "cond": "input.pressed(\"ArrowUp\") or input.pressed(\"KeyZ\")",
              "then": [
                {
                  "do": "cast",
                  "target": "rotate",
                  "args": [
                    "1"
                  ]
                }
              ]
            },
            {
              "do": "if",
              "cond": "input.pressed(\"KeyX\")",
              "then": [
                {
                  "do": "cast",
                  "target": "rotate",
                  "args": [
                    "-1"
                  ]
                }
              ]
            },
            {
              "do": "if",
              "cond": "input.pressed(\"KeyC\") or input.pressed(\"ShiftLeft\")",
              "then": [
                {
                  "do": "cast",
                  "target": "swap"
                }
              ]
            },
            {
              "do": "if",
              "cond": "input.key(\"ArrowDown\")",
              "then": [
                {
                  "do": "set",
                  "target": "soft",
                  "expr": "soft + 1"
                },
                {
                  "do": "if",
                  "cond": "soft % 3 == 0",
                  "then": [
                    {
                      "do": "cast",
                      "target": "fall",
                      "args": [
                        "true"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "do": "if",
              "cond": "input.pressed(\"Space\")",
              "then": [
                {
                  "do": "cast",
                  "target": "drop"
                }
              ]
            }
          ]
        },
        {
          "name": "rotate",
          "params": [
            {
              "name": "dir",
              "type": "num"
            }
          ],
          "steps": [
            {
              "do": "let",
              "name": "r",
              "expr": "(piece.rot + dir + 4) % 4"
            },
            {
              "do": "let",
              "name": "kx",
              "expr": "[0, 1, -1, 2, -2, 0]"
            },
            {
              "do": "let",
              "name": "ky",
              "expr": "[0, 0, 0, 0, 0, -1]"
            },
            {
              "do": "let",
              "name": "ok",
              "expr": "false"
            },
            {
              "do": "loop",
              "kind": "count",
              "name": "k",
              "times": "len(kx)",
              "steps": [
                {
                  "do": "cast",
                  "target": "fits",
                  "args": [
                    "piece.kind",
                    "r",
                    "piece.x + kx[k]",
                    "piece.y + ky[k]"
                  ],
                  "into": "ok"
                },
                {
                  "do": "if",
                  "cond": "ok",
                  "then": [
                    {
                      "do": "set",
                      "target": "piece.rot",
                      "expr": "r"
                    },
                    {
                      "do": "set",
                      "target": "piece.x",
                      "expr": "piece.x + kx[k]"
                    },
                    {
                      "do": "set",
                      "target": "piece.y",
                      "expr": "piece.y + ky[k]"
                    },
                    {
                      "do": "cast",
                      "target": "audio.tone",
                      "args": [
                        "880",
                        "10"
                      ]
                    },
                    {
                      "do": "return"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "drop",
          "steps": [
            {
              "do": "let",
              "name": "d",
              "expr": "0"
            },
            {
              "do": "cast",
              "target": "depth",
              "args": [
                "piece.kind",
                "piece.rot",
                "piece.x",
                "piece.y"
              ],
              "into": "d"
            },
            {
              "do": "set",
              "target": "piece.y",
              "expr": "piece.y + d"
            },
            {
              "do": "set",
              "target": "score",
              "expr": "score + d * 2"
            },
            {
              "do": "cast",
              "target": "lock"
            }
          ]
        },
        {
          "name": "swap",
          "steps": [
            {
              "do": "if",
              "cond": "not canHold",
              "then": [
                {
                  "do": "return"
                }
              ]
            },
            {
              "do": "set",
              "target": "canHold",
              "expr": "false"
            },
            {
              "do": "cast",
              "target": "audio.tone",
              "args": [
                "330",
                "20"
              ]
            },
            {
              "do": "if",
              "cond": "hold < 0",
              "then": [
                {
                  "do": "set",
                  "target": "hold",
                  "expr": "piece.kind"
                },
                {
                  "do": "cast",
                  "target": "spawn"
                }
              ],
              "else": [
                {
                  "do": "let",
                  "name": "k",
                  "expr": "hold"
                },
                {
                  "do": "set",
                  "target": "hold",
                  "expr": "piece.kind"
                },
                {
                  "do": "cast",
                  "target": "enter",
                  "args": [
                    "k"
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "paint",
          "steps": [
            {
              "do": "cast",
              "target": "drawBoard"
            },
            {
              "do": "if",
              "cond": "not over",
              "then": [
                {
                  "do": "let",
                  "name": "d",
                  "expr": "0"
                },
                {
                  "do": "cast",
                  "target": "depth",
                  "args": [
                    "piece.kind",
                    "piece.rot",
                    "piece.x",
                    "piece.y"
                  ],
                  "into": "d"
                },
                {
                  "do": "cast",
                  "target": "drawPiece",
                  "args": [
                    "piece.kind",
                    "piece.rot",
                    "8 + piece.x * 8",
                    "8 + (piece.y + d) * 8",
                    "8",
                    "true"
                  ]
                },
                {
                  "do": "cast",
                  "target": "drawPiece",
                  "args": [
                    "piece.kind",
                    "piece.rot",
                    "8 + piece.x * 8",
                    "8 + piece.y * 8",
                    "8",
                    "false"
                  ]
                }
              ]
            },
            {
              "do": "cast",
              "target": "canvas.ink",
              "args": [
                "\"#c8d0dc\""
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "\"HOLD\"",
                "100",
                "4"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "\"NEXT\"",
                "100",
                "42"
              ]
            },
            {
              "do": "if",
              "cond": "hold >= 0",
              "then": [
                {
                  "do": "cast",
                  "target": "drawPiece",
                  "args": [
                    "hold",
                    "0",
                    "100",
                    "14",
                    "6",
                    "not canHold"
                  ]
                }
              ]
            },
            {
              "do": "loop",
              "kind": "count",
              "name": "i",
              "times": "3",
              "steps": [
                {
                  "do": "cast",
                  "target": "drawPiece",
                  "args": [
                    "queue[i]",
                    "0",
                    "100",
                    "52 + i * 20",
                    "6",
                    "false"
                  ]
                }
              ]
            },
            {
              "do": "cast",
              "target": "canvas.ink",
              "args": [
                "\"#c8d0dc\""
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "\"SCORE \" ++ str(score)",
                "100",
                "116"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "\"LINES \" ++ str(lines)",
                "100",
                "128"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "\"LEVEL \" ++ str(level)",
                "100",
                "140"
              ]
            },
            {
              "do": "if",
              "cond": "paused",
              "then": [
                {
                  "do": "cast",
                  "target": "canvas.ink",
                  "args": [
                    "\"#f2d541\""
                  ]
                },
                {
                  "do": "cast",
                  "target": "canvas.text",
                  "args": [
                    "\"PAUSE\"",
                    "33",
                    "84"
                  ]
                }
              ],
              "else": [
                {
                  "do": "cast",
                  "target": "canvas.text",
                  "args": [
                    "\"BEST  \" ++ str(max(best, score))",
                    "100",
                    "152"
                  ]
                }
              ]
            }
          ]
        }
      ],
      "boundary": {
        "on": [
          {
            "event": "tick",
            "rite": "control"
          }
        ],
        "guards": [
          {
            "assert": "score >= 0 and lines >= 0 and level >= 0",
            "message": "得点・行数・レベルは負にならない"
          },
          {
            "assert": "hold >= -1 and hold <= 6",
            "message": "ホールドは空(-1)か 7 種のどれか"
          }
        ]
      }
    },
    {
      "name": "Board",
      "core": "idle",
      "state": [
        {
          "name": "cells",
          "type": "list<num>",
          "init": "[]",
          "out": true
        },
        {
          "name": "shapes",
          "type": "list<num>",
          "init": "[0, 1, 1, 1, 2, 1, 3, 1, 2, 0, 2, 1, 2, 2, 2, 3, 0, 2, 1, 2, 2, 2, 3, 2, 1, 0, 1, 1, 1, 2, 1, 3, 1, 0, 1, 1, 2, 0, 2, 1, 2, 1, 2, 2, 3, 1, 3, 2, 1, 2, 1, 3, 2, 2, 2, 3, 0, 1, 0, 2, 1, 1, 1, 2, 0, 1, 1, 0, 1, 1, 2, 1, 1, 0, 1, 1, 1, 2, 2, 1, 0, 1, 1, 1, 1, 2, 2, 1, 0, 1, 1, 0, 1, 1, 1, 2, 0, 1, 1, 0, 1, 1, 2, 0, 1, 0, 1, 1, 2, 1, 2, 2, 0, 2, 1, 1, 1, 2, 2, 1, 0, 0, 0, 1, 1, 1, 1, 2, 0, 0, 1, 0, 1, 1, 2, 1, 1, 1, 1, 2, 2, 0, 2, 1, 0, 1, 1, 1, 1, 2, 2, 2, 0, 1, 0, 2, 1, 0, 1, 1, 0, 0, 0, 1, 1, 1, 2, 1, 1, 0, 1, 1, 1, 2, 2, 0, 0, 1, 1, 1, 2, 1, 2, 2, 0, 2, 1, 0, 1, 1, 1, 2, 0, 1, 1, 1, 2, 0, 2, 1, 1, 0, 1, 1, 1, 2, 2, 2, 0, 1, 0, 2, 1, 1, 2, 1, 0, 0, 1, 0, 1, 1, 1, 2]"
        },
        {
          "name": "colors",
          "type": "list<str>",
          "init": "[\"#4ce0e6\", \"#f2d541\", \"#b26ce8\", \"#5fd463\", \"#ef5b5b\", \"#4f7be8\", \"#f2953d\"]"
        }
      ],
      "sigils": [
        {
          "name": "canvas",
          "kind": "host",
          "host": "canvas"
        }
      ],
      "rites": [
        {
          "name": "idle",
          "steps": []
        },
        {
          "name": "reset",
          "steps": [
            {
              "do": "cast",
              "target": "clear",
              "args": [
                "cells"
              ]
            },
            {
              "do": "loop",
              "kind": "count",
              "name": "i",
              "times": "200",
              "steps": [
                {
                  "do": "cast",
                  "target": "push",
                  "args": [
                    "cells",
                    "0"
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "fits",
          "params": [
            {
              "name": "kind",
              "type": "num"
            },
            {
              "name": "rot",
              "type": "num"
            },
            {
              "name": "x",
              "type": "num"
            },
            {
              "name": "y",
              "type": "num"
            }
          ],
          "returns": "bool",
          "steps": [
            {
              "do": "loop",
              "kind": "count",
              "name": "i",
              "times": "4",
              "steps": [
                {
                  "do": "let",
                  "name": "cx",
                  "expr": "x + shapes[((kind * 4 + rot) * 4 + i) * 2]"
                },
                {
                  "do": "let",
                  "name": "cy",
                  "expr": "y + shapes[((kind * 4 + rot) * 4 + i) * 2 + 1]"
                },
                {
                  "do": "if",
                  "cond": "cx < 0 or cx >= 10 or cy >= 20",
                  "then": [
                    {
                      "do": "return",
                      "expr": "false"
                    }
                  ]
                },
                {
                  "do": "if",
                  "cond": "cy >= 0 and cells[cy * 10 + cx] != 0",
                  "then": [
                    {
                      "do": "return",
                      "expr": "false"
                    }
                  ]
                }
              ]
            },
            {
              "do": "return",
              "expr": "true"
            }
          ]
        },
        {
          "name": "depth",
          "params": [
            {
              "name": "kind",
              "type": "num"
            },
            {
              "name": "rot",
              "type": "num"
            },
            {
              "name": "x",
              "type": "num"
            },
            {
              "name": "y",
              "type": "num"
            }
          ],
          "returns": "num",
          "steps": [
            {
              "do": "let",
              "name": "d",
              "expr": "0"
            },
            {
              "do": "let",
              "name": "ok",
              "expr": "true"
            },
            {
              "do": "loop",
              "kind": "while",
              "cond": "ok",
              "steps": [
                {
                  "do": "cast",
                  "target": "fits",
                  "args": [
                    "kind",
                    "rot",
                    "x",
                    "y + d + 1"
                  ],
                  "into": "ok"
                },
                {
                  "do": "if",
                  "cond": "ok",
                  "then": [
                    {
                      "do": "set",
                      "target": "d",
                      "expr": "d + 1"
                    }
                  ]
                }
              ]
            },
            {
              "do": "return",
              "expr": "d"
            }
          ]
        },
        {
          "name": "place",
          "params": [
            {
              "name": "kind",
              "type": "num"
            },
            {
              "name": "rot",
              "type": "num"
            },
            {
              "name": "x",
              "type": "num"
            },
            {
              "name": "y",
              "type": "num"
            }
          ],
          "returns": "num",
          "steps": [
            {
              "do": "loop",
              "kind": "count",
              "name": "i",
              "times": "4",
              "steps": [
                {
                  "do": "let",
                  "name": "cx",
                  "expr": "x + shapes[((kind * 4 + rot) * 4 + i) * 2]"
                },
                {
                  "do": "let",
                  "name": "cy",
                  "expr": "y + shapes[((kind * 4 + rot) * 4 + i) * 2 + 1]"
                },
                {
                  "do": "if",
                  "cond": "cy >= 0",
                  "then": [
                    {
                      "do": "set",
                      "target": "cells[cy * 10 + cx]",
                      "expr": "kind + 1"
                    }
                  ]
                }
              ]
            },
            {
              "do": "let",
              "name": "n",
              "expr": "0"
            },
            {
              "do": "cast",
              "target": "sweep",
              "into": "n"
            },
            {
              "do": "return",
              "expr": "n"
            }
          ]
        },
        {
          "name": "sweep",
          "returns": "num",
          "steps": [
            {
              "do": "let",
              "name": "cleared",
              "expr": "0"
            },
            {
              "do": "loop",
              "kind": "count",
              "name": "r",
              "times": "20",
              "steps": [
                {
                  "do": "let",
                  "name": "full",
                  "expr": "true"
                },
                {
                  "do": "loop",
                  "kind": "count",
                  "name": "c",
                  "times": "10",
                  "steps": [
                    {
                      "do": "if",
                      "cond": "cells[r * 10 + c] == 0",
                      "then": [
                        {
                          "do": "set",
                          "target": "full",
                          "expr": "false"
                        }
                      ]
                    }
                  ]
                },
                {
                  "do": "if",
                  "cond": "full",
                  "then": [
                    {
                      "do": "loop",
                      "kind": "count",
                      "name": "k",
                      "times": "r * 10",
                      "steps": [
                        {
                          "do": "let",
                          "name": "j",
                          "expr": "r * 10 - 1 - k"
                        },
                        {
                          "do": "set",
                          "target": "cells[j + 10]",
                          "expr": "cells[j]"
                        }
                      ]
                    },
                    {
                      "do": "loop",
                      "kind": "count",
                      "name": "c2",
                      "times": "10",
                      "steps": [
                        {
                          "do": "set",
                          "target": "cells[c2]",
                          "expr": "0"
                        }
                      ]
                    },
                    {
                      "do": "set",
                      "target": "cleared",
                      "expr": "cleared + 1"
                    }
                  ]
                }
              ]
            },
            {
              "do": "return",
              "expr": "cleared"
            }
          ]
        },
        {
          "name": "paint",
          "steps": [
            {
              "do": "cast",
              "target": "canvas.clear",
              "args": [
                "\"#101418\""
              ]
            },
            {
              "do": "cast",
              "target": "canvas.ink",
              "args": [
                "\"#2a3340\""
              ]
            },
            {
              "do": "cast",
              "target": "canvas.rect",
              "args": [
                "6",
                "6",
                "84",
                "164"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.ink",
              "args": [
                "\"#000\""
              ]
            },
            {
              "do": "cast",
              "target": "canvas.rect",
              "args": [
                "8",
                "8",
                "80",
                "160"
              ]
            },
            {
              "do": "loop",
              "kind": "count",
              "name": "i",
              "times": "200",
              "steps": [
                {
                  "do": "if",
                  "cond": "cells[i] != 0",
                  "then": [
                    {
                      "do": "cast",
                      "target": "canvas.ink",
                      "args": [
                        "colors[cells[i] - 1]"
                      ]
                    },
                    {
                      "do": "cast",
                      "target": "canvas.rect",
                      "args": [
                        "8 + i % 10 * 8",
                        "8 + floor(i / 10) * 8",
                        "7",
                        "7"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "piece",
          "params": [
            {
              "name": "kind",
              "type": "num"
            },
            {
              "name": "rot",
              "type": "num"
            },
            {
              "name": "left",
              "type": "num"
            },
            {
              "name": "top",
              "type": "num"
            },
            {
              "name": "size",
              "type": "num"
            },
            {
              "name": "ghost",
              "type": "bool"
            }
          ],
          "steps": [
            {
              "do": "if",
              "cond": "ghost",
              "then": [
                {
                  "do": "cast",
                  "target": "canvas.ink",
                  "args": [
                    "\"#3a4250\""
                  ]
                }
              ],
              "else": [
                {
                  "do": "cast",
                  "target": "canvas.ink",
                  "args": [
                    "colors[kind]"
                  ]
                }
              ]
            },
            {
              "do": "loop",
              "kind": "count",
              "name": "i",
              "times": "4",
              "steps": [
                {
                  "do": "let",
                  "name": "py",
                  "expr": "top + shapes[((kind * 4 + rot) * 4 + i) * 2 + 1] * size"
                },
                {
                  "do": "if",
                  "cond": "py >= 8",
                  "then": [
                    {
                      "do": "cast",
                      "target": "canvas.rect",
                      "args": [
                        "left + shapes[((kind * 4 + rot) * 4 + i) * 2] * size",
                        "py",
                        "size - 1",
                        "size - 1"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "boundary": {
        "guards": [
          {
            "assert": "len(cells) == 0 or len(cells) == 200",
            "message": "盤面は 10 × 20"
          }
        ]
      }
    },
    {
      "name": "Result",
      "core": "show",
      "state": [
        {
          "name": "quit",
          "type": "bool",
          "init": "false",
          "out": true
        }
      ],
      "sigils": [
        {
          "name": "canvas",
          "kind": "host",
          "host": "canvas"
        },
        {
          "name": "ui",
          "kind": "host",
          "host": "ui"
        }
      ],
      "rites": [
        {
          "name": "show",
          "steps": [
            {
              "do": "set",
              "target": "quit",
              "expr": "false"
            },
            {
              "do": "wait",
              "ticks": "20"
            }
          ]
        },
        {
          "name": "menu",
          "steps": [
            {
              "do": "cast",
              "target": "canvas.clear",
              "args": [
                "\"#101418\""
              ]
            },
            {
              "do": "cast",
              "target": "canvas.ink",
              "args": [
                "\"#3a4250\""
              ]
            },
            {
              "do": "loop",
              "kind": "count",
              "name": "i",
              "times": "200",
              "steps": [
                {
                  "do": "if",
                  "cond": "Board.cells[i] != 0",
                  "then": [
                    {
                      "do": "cast",
                      "target": "canvas.rect",
                      "args": [
                        "8 + i % 10 * 8",
                        "8 + floor(i / 10) * 8",
                        "7",
                        "7"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "do": "cast",
              "target": "canvas.ink",
              "args": [
                "\"#c8d0dc\""
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "\"GAME OVER\"",
                "100",
                "8"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "\"SCORE \" ++ str(Play.score)",
                "100",
                "28"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "\"LINES \" ++ str(Play.lines)",
                "100",
                "40"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "\"LEVEL \" ++ str(Play.level)",
                "100",
                "52"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "\"BEST  \" ++ str(Play.best)",
                "100",
                "64"
              ]
            },
            {
              "do": "if",
              "cond": "Play.record",
              "then": [
                {
                  "do": "cast",
                  "target": "canvas.ink",
                  "args": [
                    "\"#f2d541\""
                  ]
                },
                {
                  "do": "cast",
                  "target": "canvas.text",
                  "args": [
                    "\"新記録！\"",
                    "100",
                    "76"
                  ]
                }
              ]
            },
            {
              "do": "if",
              "cond": "ui.button(\"RETRY\", 100, 100, 64, 20)",
              "then": [
                {
                  "do": "finish"
                }
              ]
            },
            {
              "do": "if",
              "cond": "ui.button(\"QUIT\", 100, 128, 64, 20)",
              "then": [
                {
                  "do": "set",
                  "target": "quit",
                  "expr": "true"
                },
                {
                  "do": "finish"
                }
              ]
            }
          ]
        }
      ],
      "boundary": {
        "on": [
          {
            "event": "tick",
            "rite": "menu"
          }
        ]
      }
    }
  ]
}
