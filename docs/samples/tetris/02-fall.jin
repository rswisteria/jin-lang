{
  "$schema": "https://xtone.internal/jin/schemas/jin-v2.schema.json",
  "version": 2,
  "root": "Play",
  "stage": {
    "width": 176,
    "height": 176,
    "fps": 30,
    "seed": 3
  },
  "circles": [
    {
      "name": "Play",
      "core": "begin",
      "state": [
        {
          "name": "x",
          "type": "num",
          "init": "3",
          "out": true
        },
        {
          "name": "y",
          "type": "num",
          "init": "0",
          "out": true
        }
      ],
      "sigils": [
        {
          "name": "canvas",
          "kind": "host",
          "host": "canvas"
        }
      ],
      "rites": [
        {
          "name": "begin",
          "steps": [
            {
              "do": "set",
              "target": "y",
              "expr": "0"
            },
            {
              "do": "loop",
              "kind": "while",
              "cond": "y < 19",
              "steps": [
                {
                  "do": "wait",
                  "ticks": "15"
                },
                {
                  "do": "set",
                  "target": "y",
                  "expr": "y + 1"
                }
              ]
            },
            {
              "do": "wait",
              "ticks": "30"
            },
            {
              "do": "finish"
            }
          ]
        },
        {
          "name": "paint",
          "steps": [
            {
              "do": "cast",
              "target": "canvas.clear",
              "args": [
                "\"#101418\""
              ]
            },
            {
              "do": "cast",
              "target": "canvas.ink",
              "args": [
                "\"#2a3340\""
              ]
            },
            {
              "do": "cast",
              "target": "canvas.rect",
              "args": [
                "6",
                "6",
                "84",
                "164"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.ink",
              "args": [
                "\"#000\""
              ]
            },
            {
              "do": "cast",
              "target": "canvas.rect",
              "args": [
                "8",
                "8",
                "80",
                "160"
              ]
            },
            {
              "do": "cast",
              "target": "canvas.ink",
              "args": [
                "\"#4ce0e6\""
              ]
            },
            {
              "do": "cast",
              "target": "canvas.rect",
              "args": [
                "8 + x * 8",
                "8 + y * 8",
                "7",
                "7"
              ]
            }
          ]
        }
      ],
      "boundary": {
        "on": [
          {
            "event": "tick",
            "rite": "paint"
          }
        ]
      }
    }
  ]
}
