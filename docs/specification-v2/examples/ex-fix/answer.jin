{
  "$schema": "https://xtone.internal/jin/schemas/jin-v2.schema.json",
  "version": 2,
  "root": "Clicker",
  "stage": {
    "width": 96,
    "height": 32
  },
  "circles": [
    {
      "name": "Clicker",
      "core": "begin",
      "state": [
        {
          "name": "score",
          "type": "num",
          "init": "0",
          "out": true
        }
      ],
      "sigils": [
        {
          "name": "canvas",
          "kind": "host",
          "host": "canvas"
        },
        {
          "name": "input",
          "kind": "host",
          "host": "input"
        }
      ],
      "rites": [
        {
          "name": "begin",
          "steps": []
        },
        {
          "name": "press",
          "params": [
            {
              "name": "name",
              "type": "str"
            },
            {
              "name": "down",
              "type": "bool"
            }
          ],
          "steps": [
            {
              "do": "if",
              "cond": "down and name == \"Space\"",
              "then": [
                {
                  "do": "set",
                  "target": "score",
                  "expr": "score + 1"
                }
              ]
            }
          ]
        },
        {
          "name": "draw",
          "steps": [
            {
              "do": "cast",
              "target": "canvas.clear",
              "args": [
                "\"#000\""
              ]
            },
            {
              "do": "cast",
              "target": "canvas.text",
              "args": [
                "\"SCORE \" ++ str(score)",
                "4",
                "4"
              ]
            }
          ]
        }
      ],
      "boundary": {
        "on": [
          {
            "event": "tick",
            "rite": "draw"
          },
          {
            "event": "key",
            "rite": "press"
          }
        ]
      }
    }
  ]
}
