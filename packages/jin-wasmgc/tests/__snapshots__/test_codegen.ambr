  '''
# ---
# name: test_program_snapshot[release-clicker]
  '''
    (rec
      (type $S0 (struct (field (mut f64)) (field (mut f64)) (field (mut (ref $str)))))
    )
    (func $jf0 (param $v (ref null $F0))  ;; Pointer
      (call $putc (i32.const 123))
      (call $puts (i32.const 2048) (i32.const 4))
      (call $put_jn (struct.get $F0 0 (local.get $v)))
      (call $puts (i32.const 2052) (i32.const 5))
      (call $put_jn (struct.get $F0 1 (local.get $v)))
      (call $puts (i32.const 2057) (i32.const 8))
      (call $put_bool (struct.get $F0 2 (local.get $v)))
      (call $putc (i32.const 125)))
    (func $r0_0w (param $fr (ref $W0_0)) (result i32) ;; Clicker.grow（wait を含む）
      (local $rs i32) (local $ob (ref null $buf))
      (local.set $rs (i32.ne (struct.get $W0_0 0 (local.get $fr)) (i32.const 0)))
      (if (i32.or (i32.eqz (local.get $rs)) (i32.and (i32.gt_s (struct.get $W0_0 0 (local.get $fr)) (i32.const 0)) (i32.le_s (struct.get $W0_0 0 (local.get $fr)) (i32.const 1))))
        (then
          (block $brk1
            (loop $loop2
              (if (i32.eqz (local.get $rs))
                (then
                  (br_if $brk1 (i32.eqz (i32.const 1)))
                ))
              (if (local.get $rs)
                (then (if (i32.eq (struct.get $W0_0 0 (local.get $fr)) (i32.const 1)) (then (local.set $rs (i32.const 0)))))
                (else
                  (global.set $WREQ_KIND (i32.const 1))
                  (global.set $WREQ_TICKS (call $wait_ticks_of (f64.const 60.0)))
                  (global.set $WREQ_PTR (call $mem_str (i32.const 2065) (i32.const 34)))
                  (global.set $WREQ_TOP (local.get $fr))
                  (struct.set $W0_0 0 (local.get $fr) (i32.const 1))
                  (return (i32.const 1))))
              (if (i32.eqz (local.get $rs))
                (then
                  (struct.set $S0 0 (global.get $S0) (f64.add (struct.get $S0 0 (global.get $S0)) (struct.get $S0 1 (global.get $S0))))
                  (if (f64.lt (call $h_random_next) (f64.const 0.1))
                    (then
                      (if (i32.eqz (local.get $rs))
                        (then
                          (struct.set $S0 2 (global.get $S0) (array.new_data $str $L0 (i32.const 0) (i32.const 9)))
                          (struct.set $S0 0 (global.get $S0) (f64.add (struct.get $S0 0 (global.get $S0)) (f64.const 10.0)))
                        ))
                    )
                    (else
                      (if (i32.eqz (local.get $rs))
                        (then
                          (struct.set $S0 2 (global.get $S0) (array.new_data $str $L1 (i32.const 0) (i32.const 0)))
                        ))
                    )
                  )
                ))
              (call $bud)
              (br_if $brk1 (global.get $ERRED))
              (br $loop2)
            )
          )
          (if (global.get $ERRED) (then (return (i32.const 0))))
        ))
      (i32.const 0))
    (func $run0_0
      (local $fr (ref null $W0_0))
      (local.set $fr (struct.new_default $W0_0))
      (if (call $r0_0w (ref.as_non_null (local.get $fr))) (then (call $register_wait (i32.const 0) (i32.const 0) (local.get $fr)))))
    (func $r0_1 ;; Clicker.screen
      (local $ob (ref null $buf))
      (call $h_canvas_clear (array.new_data $str $L2 (i32.const 0) (i32.const 4)))
      (if (global.get $ERRED) (then (return)))
      (call $h_ui_label (call $str_cat (array.new_data $str $L3 (i32.const 0) (i32.const 8)) (call $f_str (struct.get $S0 0 (global.get $S0)))) (f64.const 8.0) (f64.const 8.0))
      (if (global.get $ERRED) (then (return)))
      (call $h_ui_label (call $str_cat (call $str_cat (array.new_data $str $L4 (i32.const 0) (i32.const 5)) (call $f_str (struct.get $S0 1 (global.get $S0)))) (array.new_data $str $L5 (i32.const 0) (i32.const 2))) (f64.const 8.0) (f64.const 20.0))
      (if (global.get $ERRED) (then (return)))
      (call $h_ui_label (struct.get $S0 2 (global.get $S0)) (f64.const 8.0) (f64.const 32.0))
      (if (global.get $ERRED) (then (return)))
      (if (call $h_ui_button (array.new_data $str $L6 (i32.const 0) (i32.const 5)) (f64.const 20.0) (f64.const 60.0) (f64.const 90.0) (f64.const 28.0))
        (then
          (struct.set $S0 0 (global.get $S0) (f64.add (struct.get $S0 0 (global.get $S0)) (f64.const 1.0)))
        )
      )
      (if (if (result i32) (call $h_ui_button (array.new_data $str $L7 (i32.const 0) (i32.const 7)) (f64.const 130.0) (f64.const 60.0) (f64.const 90.0) (f64.const 28.0)) (then (f64.ge (struct.get $S0 0 (global.get $S0)) (f64.const 10.0))) (else (i32.const 0)))
        (then
          (struct.set $S0 0 (global.get $S0) (f64.sub (struct.get $S0 0 (global.get $S0)) (f64.const 10.0)))
          (struct.set $S0 1 (global.get $S0) (f64.add (struct.get $S0 1 (global.get $S0)) (f64.const 1.0)))
        )
      )
      (if (call $h_ui_button (array.new_data $str $L8 (i32.const 0) (i32.const 4)) (f64.const 75.0) (f64.const 110.0) (f64.const 90.0) (f64.const 28.0))
        (then
          (call $finish (i32.const 0))
          (return)
        )
      )
    )
    (func $run0_1
      (call $r0_1))
    ;; circle 0: Clicker
    (global $S0 (mut (ref $S0)) (struct.new $S0 (f64.const 0) (f64.const 0) (array.new_fixed $str 0)))
    (global $P0 (mut (ref $S0)) (struct.new $S0 (f64.const 0) (f64.const 0) (array.new_fixed $str 0)))
    (func $init0 (global.set $S0 (struct.new $S0 (f64.const 0.0) (f64.const 0.0) (array.new_data $str $L1 (i32.const 0) (i32.const 0)))))
    (func $publish0
      (struct.set $S0 0 (global.get $P0) (struct.get $S0 0 (global.get $S0)))
    )
    (func $pub0
      (call $pub_comma)
      (call $puts (i32.const 2099) (i32.const 16))
      (call $put_jn (struct.get $S0 0 (global.get $P0)))
    )
    (func $on_tick0
      (local $ob (ref null $buf))
      (call $run0_1))
    (func $prog_flow (param $i i32) (result i32)
      (i32.const 0))
    (func $prog_nchildren (param $i i32) (result i32)
      (i32.const 0))
    (func $prog_child (param $i i32) (param $k i32) (result i32)
      (i32.const -1))
    (func $prog_exit (param $i i32) (result i32)
      (i32.const 0))
    (func $prog_init (param $i i32)
      (if (i32.eq (local.get $i) (i32.const 0)) (then (call $init0) (return)))
      )
    (func $prog_publish (param $i i32)
      (if (i32.eq (local.get $i) (i32.const 0)) (then (call $publish0) (return)))
      )
    (func $prog_has_outs (param $i i32) (result i32)
      (if (i32.eq (local.get $i) (i32.const 0)) (then (return (i32.const 1))))
      (i32.const 0))
    (func $prog_pub (param $i i32)
      (if (i32.eq (local.get $i) (i32.const 0)) (then (call $pub0) (return)))
      )
    (func $prog_core (param $i i32)
      (if (i32.eq (local.get $i) (i32.const 0)) (then (call $run0_0) (return)))
      )
    (func $prog_name (param $i i32) (result (ref $str))
      (if (i32.eq (local.get $i) (i32.const 0)) (then (return (call $mem_str (i32.const 2139) (i32.const 7)))))
      (call $str_empty))
    (func $prog_find (param $s (ref null $str)) (result i32)
      (if (call $str_eq_mem (local.get $s) (i32.const 2139) (i32.const 7)) (then (return (i32.const 0))))
      (i32.const -1))
    (func $prog_has_on (param $i i32) (param $kind i32) (result i32)
      (if (i32.and (i32.eq (local.get $i) (i32.const 0)) (i32.eq (local.get $kind) (i32.const 3))) (then (return (i32.const 1))))
      (i32.const 0))
    (func $prog_on_key (param $i i32) (param $k i32)
      )
    (func $prog_on_pointer (param $i i32) (param $k i32)
      )
    (func $prog_on_tick (param $i i32)
      (if (i32.eq (local.get $i) (i32.const 0)) (then (call $on_tick0) (return)))
      )
    (func $prog_on_exit (param $i i32)
      )
    (func $prog_deliver (param $i i32) (param $m (ref null $Msg))
      )
    (func $prog_reply (param $i i32) (param $id f64) (param $text (ref $str))
      )
    (func $prog_resume (param $i i32) (param $fr anyref) (result i32)
      (if (i32.eq (local.get $i) (i32.const 0)) (then (return (call $r0_0w (ref.cast (ref $W0_0) (local.get $fr))))))
      (i32.const 0))
    (func $prog_until (param $i i32) (param $fr anyref) (result i32)
      (i32.const 0))
    (func $prog_dump (param $i i32))
    (func $prog_pdump (param $i i32))
