    pdump = function() return '{' .. '"board":' .. JL(JV)(P[2].k_0) .. ',' .. '"piece":' .. JF[1](P[2].k_1) .. ',' .. '"score":' .. JV(P[2].k_3) .. ',' .. '"lines":' .. JV(P[2].k_4) .. ',' .. '"placed":' .. JV(P[2].k_5) .. '}' end,
