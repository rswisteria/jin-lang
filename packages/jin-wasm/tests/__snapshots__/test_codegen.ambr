  '''
# ---
# name: test_program_snapshot[release-clicker]
  '''
  DEBUG = false
  ROOT = 1
  FPS = 60.0
  JF[0] = function(v) return '{' .. '"x":' .. JV(v.f_0) .. ',' .. '"y":' .. JV(v.f_1) .. ',' .. '"down":' .. JV(v.f_2) .. '}' end  -- Pointer
  R[1] = {}
  -- circle 0: Clicker
  R[1][1] = function()  -- grow
    while true do
      WAIT_TICKS(60.0, "/circles/0/rites/0/steps/0/steps/0")
      S[1].k_0 = (S[1].k_0 + S[1].k_1)
      if (H.random.next() < 0.1) then
        S[1].k_2 = "LUCKY +10"
        S[1].k_0 = (S[1].k_0 + 10.0)
      else
        S[1].k_2 = ""
      end
    end
  end
  R[1][2] = function()  -- screen
    H.canvas.clear("#123")
    H.ui.label(("COOKIES " .. F.str(S[1].k_0)), 8.0, 8.0)
    H.ui.label((("RATE " .. F.str(S[1].k_1)) .. "/s"), 8.0, 20.0)
    H.ui.label(S[1].k_2, 8.0, 32.0)
    if H.ui.button("CLICK", 20.0, 60.0, 90.0, 28.0) then
      S[1].k_0 = (S[1].k_0 + 1.0)
    end
    if (H.ui.button("UPGRADE", 130.0, 60.0, 90.0, 28.0) and (S[1].k_0 >= 10.0)) then
      S[1].k_0 = (S[1].k_0 - 10.0)
      S[1].k_1 = (S[1].k_1 + 1.0)
    end
    if H.ui.button("DONE", 75.0, 110.0, 90.0, 28.0) then
      FINISH(1)
      do return end
    end
  end
  CIRCLES[1] = {
    name = "Clicker",
    init = function() return { k_0 = 0.0, k_1 = 0.0, k_2 = "" } end,
    publish = function() P[1].k_0 = S[1].k_0 end,
    pub = function() return '"Clicker.count":' .. JV(P[1].k_0) end,
    core = R[1][1], core_waits = true,
    on = { tick = R[1][2] },
    on_waits = { tick = false },
    on_ptr = { tick = "/circles/0/boundary/on/0" },
  }
  return { boot = boot, tick = tick }
  
  '''
# ---
# name: test_program_snapshot[release-fib]
  '''
  DEBUG = false
  ROOT = 1
  FPS = 60.0
  JF[0] = function(v) return '{' .. '"x":' .. JV(v.f_0) .. ',' .. '"y":' .. JV(v.f_1) .. ',' .. '"down":' .. JV(v.f_2) .. '}' end  -- Pointer
  R[1] = {}
  -- circle 0: Fib
  R[1][1] = function(l_0)  -- fib
    local l_1 = 0.0
    local l_2 = 1.0
    do
      local n_1 = math.floor(l_0)
      for i_2 = 0, n_1 - 1 do
        local l_3 = (l_1 + l_2)
        l_1 = l_2
        l_2 = l_3
      end
    end
    do return l_1 end
  end
  R[1][2] = function()  -- main
    local r_1 = R[1][1](20.0)
    if STOP(1) then return end
    S[1].k_0 = r_1
    FINISH(1)
    do return end
  end
  CIRCLES[1] = {
    name = "Fib",
    init = function() return { k_0 = 0.0 } end,
    publish = function() P[1].k_0 = S[1].k_0 end,
    pub = function() return '"Fib.answer":' .. JV(P[1].k_0) end,
    core = R[1][2], core_waits = false,
  }
  return { boot = boot, tick = tick }
  
  '''
# ---
# name: test_program_snapshot[release-othello]
  '''
  DEBUG = false
  ROOT = 1
  FPS = 30.0
  JF[0] = function(v) return '{' .. '"x":' .. JV(v.f_0) .. ',' .. '"y":' .. JV(v.f_1) .. ',' .. '"down":' .. JV(v.f_2) .. '}' end  -- Pointer
  R[3] = {}
  R[4] = {}
  R[5] = {}
  R[6] = {}
  -- circle 2: Board
  R[3][1] = function()  -- idle
    WAIT_UNTIL(function() return P[5].k_1 end, "/circles/2/rites/0/steps/0")
    FINISH(3)
    do return end
  end
  R[3][2] = function()  -- resetBoard
    E.clear(S[3].k_0)
    do
      local n_1 = math.floor(64.0)
      for i_2 = 0, n_1 - 1 do
        local l_0 = i_2 + 0.0
        E.push(S[3].k_0, 0.0)
      end
    end
    SETAT(S[3].k_0, 27.0, 2.0)
    SETAT(S[3].k_0, 28.0, 1.0)
    SETAT(S[3].k_0, 35.0, 1.0)
    SETAT(S[3].k_0, 36.0, 2.0)
    S[3].k_4 = (-1.0)
    R[3][3]()
    if STOP(3) then return end
  end
  R[3][3] = function()  -- count
    S[3].k_2 = 0.0
    S[3].k_3 = 0.0
    do
      local n_1 = math.floor(64.0)
      for i_2 = 0, n_1 - 1 do
        local l_0 = i_2 + 0.0
        if (AT(S[3].k_0, l_0) == 1.0) then
          S[3].k_2 = (S[3].k_2 + 1.0)
        end
        if (AT(S[3].k_0, l_0) == 2.0) then
          S[3].k_3 = (S[3].k_3 + 1.0)
        end
      end
    end
  end
  R[3][4] = function(l_0, l_1, l_2, l_3, l_4)  -- flips
    local l_5 = (l_0 + l_2)
    local l_6 = (l_1 + l_3)
    local l_7 = 0.0
    while (((((l_5 >= 0.0) and (l_5 < 8.0)) and (l_6 >= 0.0)) and (l_6 < 8.0)) and (AT(S[3].k_0, ((l_6 * 8.0) + l_5)) == (3.0 - l_4))) do
      l_7 = (l_7 + 1.0)
      l_5 = (l_5 + l_2)
      l_6 = (l_6 + l_3)
    end
    if ((((((l_7 > 0.0) and (l_5 >= 0.0)) and (l_5 < 8.0)) and (l_6 >= 0.0)) and (l_6 < 8.0)) and (AT(S[3].k_0, ((l_6 * 8.0) + l_5)) == l_4)) then
      do return l_7 end
    end
    do return 0.0 end
  end
  R[3][5] = function(l_0, l_1, l_2)  -- legal
    if (((((l_0 < 0.0) or (l_0 > 7.0)) or (l_1 < 0.0)) or (l_1 > 7.0)) or (AT(S[3].k_0, ((l_1 * 8.0) + l_0)) ~= 0.0)) then
      do return false end
    end
    do
      local n_1 = math.floor(8.0)
      for i_2 = 0, n_1 - 1 do
        local l_3 = i_2 + 0.0
        local l_4 = 0.0
        local r_3 = R[3][4](l_0, l_1, AT(S[3].k_5, (l_3 * 2.0)), AT(S[3].k_5, ((l_3 * 2.0) + 1.0)), l_2)
        if STOP(3) then return end
        l_4 = r_3
        if (l_4 > 0.0) then
          do return true end
        end
      end
    end
    do return false end
  end
  R[3][6] = function(l_0, l_1, l_2)  -- gain
    local l_3 = 0.0
    do
      local n_1 = math.floor(8.0)
      for i_2 = 0, n_1 - 1 do
        local l_4 = i_2 + 0.0
        local l_5 = 0.0
        local r_3 = R[3][4](l_0, l_1, AT(S[3].k_5, (l_4 * 2.0)), AT(S[3].k_5, ((l_4 * 2.0) + 1.0)), l_2)
        if STOP(3) then return end
        l_5 = r_3
        l_3 = (l_3 + l_5)
      end
    end
    do return l_3 end
  end
  R[3][7] = function(l_0, l_1, l_2)  -- place
    SETAT(S[3].k_0, ((l_1 * 8.0) + l_0), l_2)
    do
      local n_1 = math.floor(8.0)
      for i_2 = 0, n_1 - 1 do
        local l_3 = i_2 + 0.0
        local l_4 = AT(S[3].k_5, (l_3 * 2.0))
        local l_5 = AT(S[3].k_5, ((l_3 * 2.0) + 1.0))
        local l_6 = 0.0
        local r_3 = R[3][4](l_0, l_1, l_4, l_5, l_2)
        if STOP(3) then return end
        l_6 = r_3
        do
          local n_4 = math.floor(l_6)
          for i_5 = 0, n_4 - 1 do
            local l_7 = i_5 + 0.0
            SETAT(S[3].k_0, ((((l_1 + (l_5 * (l_7 + 1.0))) * 8.0) + l_0) + (l_4 * (l_7 + 1.0))), l_2)
          end
        end
      end
    end
    S[3].k_4 = ((l_1 * 8.0) + l_0)
    R[3][3]()
    if STOP(3) then return end
  end
  R[3][8] = function(l_0)  -- anyMove
    do
      local n_1 = math.floor(64.0)
      for i_2 = 0, n_1 - 1 do
        local l_1 = i_2 + 0.0
        local l_2 = false
        local r_3 = R[3][5]((l_1 % 8.0), F.floor((l_1 / 8.0)), l_0)
        if STOP(3) then return end
        l_2 = r_3
        if l_2 then
          do return true end
        end
      end
    end
    do return false end
  end
  R[3][9] = function(l_0)  -- computeHints
    E.clear(S[3].k_1)
    do
      local n_1 = math.floor(64.0)
      for i_2 = 0, n_1 - 1 do
        local l_1 = i_2 + 0.0
        local l_2 = false
        local r_3 = R[3][5]((l_1 % 8.0), F.floor((l_1 / 8.0)), l_0)
        if STOP(3) then return end
        l_2 = r_3
        if l_2 then
          E.push(S[3].k_1, l_1)
        end
      end
    end
  end
  R[3][10] = function(l_0)  -- greedy
    local l_1 = 0.0
    local l_2 = (-1.0)
    do
      local n_1 = math.floor(64.0)
      for i_2 = 0, n_1 - 1 do
        local l_3 = i_2 + 0.0
        local l_4 = false
        local r_3 = R[3][5]((l_3 % 8.0), F.floor((l_3 / 8.0)), l_0)
        if STOP(3) then return end
        l_4 = r_3
        if l_4 then
          local l_5 = 0.0
          local r_4 = R[3][6]((l_3 % 8.0), F.floor((l_3 / 8.0)), l_0)
          if STOP(3) then return end
          l_5 = r_4
          if (l_5 > l_1) then
            l_1 = l_5
            l_2 = l_3
          end
        end
      end
    end
    if (l_2 >= 0.0) then
      R[3][7]((l_2 % 8.0), F.floor((l_2 / 8.0)), l_0)
      if STOP(3) then return end
    end
  end
  R[3][11] = function(l_0)  -- legalList
    local l_1 = ""
    do
      local n_1 = math.floor(64.0)
      for i_2 = 0, n_1 - 1 do
        local l_2 = i_2 + 0.0
        local l_3 = false
        local r_3 = R[3][5]((l_2 % 8.0), F.floor((l_2 / 8.0)), l_0)
        if STOP(3) then return end
        l_3 = r_3
        if l_3 then
          l_1 = (((l_1 .. F.sub(S[3].k_6, (l_2 % 8.0), 1.0)) .. F.str((F.floor((l_2 / 8.0)) + 1.0))) .. " ")
        end
      end
    end
    do return l_1 end
  end
  -- circle 3: View
  R[4][1] = function()  -- idle
    WAIT_UNTIL(function() return P[5].k_1 end, "/circles/3/rites/0/steps/0")
    FINISH(4)
    do return end
  end
  R[4][2] = function()  -- paint
    R[4][3]()
    if STOP(4) then return end
    R[4][5]()
    if STOP(4) then return end
    R[4][6]()
    if STOP(4) then return end
  end
  R[4][3] = function()  -- paintBoard
    H.canvas.clear("#1b1f24")
    H.canvas.ink("#2e8b57")
    H.canvas.rect(8.0, 8.0, 128.0, 128.0)
    H.canvas.ink("#1f5f3a")
    do
      local n_1 = math.floor(9.0)
      for i_2 = 0, n_1 - 1 do
        local l_0 = i_2 + 0.0
        H.canvas.line((8.0 + (l_0 * 16.0)), 8.0, (8.0 + (l_0 * 16.0)), 136.0)
        H.canvas.line(8.0, (8.0 + (l_0 * 16.0)), 136.0, (8.0 + (l_0 * 16.0)))
      end
    end
    H.canvas.ink("#111")
    R[4][4](1.0)
    if STOP(4) then return end
    H.canvas.ink("#eee")
    R[4][4](2.0)
    if STOP(4) then return end
    if (P[3].k_4 >= 0.0) then
      H.canvas.ink("#e8c547")
      H.canvas.rect((15.0 + ((P[3].k_4 % 8.0) * 16.0)), (15.0 + (F.floor((P[3].k_4 / 8.0)) * 16.0)), 3.0, 3.0)
    end
  end
  R[4][4] = function(l_0)  -- paintStones
    do
      local n_1 = math.floor(64.0)
      for i_2 = 0, n_1 - 1 do
        local l_1 = i_2 + 0.0
        if (AT(P[3].k_0, l_1) == l_0) then
          H.canvas.circle((16.0 + ((l_1 % 8.0) * 16.0)), (16.0 + (F.floor((l_1 / 8.0)) * 16.0)), 6.0)
        end
      end
    end
  end
  R[4][5] = function()  -- paintHints
    if ((P[5].k_0 ~= 1.0) or P[5].k_1) then
      do return end
    end
    H.canvas.ink("#7cc47c")
    do
      local list_1 = P[3].k_1
      for i_2 = 1, #list_1 do
        local l_0 = list_1[i_2]
        H.canvas.circle((16.0 + ((l_0 % 8.0) * 16.0)), (16.0 + (F.floor((l_0 / 8.0)) * 16.0)), 2.0)
      end
    end
  end
  R[4][6] = function()  -- paintPanel
    H.canvas.ink("#c8d0dc")
    H.canvas.text("BLACK X", 144.0, 8.0)
    H.canvas.text(F.str(P[3].k_2), 144.0, 18.0)
    H.canvas.text("WHITE O", 144.0, 36.0)
    H.canvas.text(F.str(P[3].k_3), 144.0, 46.0)
    local l_0 = "AI TURN"
    if (P[5].k_0 == 1.0) then
      l_0 = "YOUR TURN"
    end
    if P[5].k_4 then
      l_0 = "THINKING"
    end
    if P[5].k_1 then
      l_0 = "GAME OVER"
    end
    H.canvas.text(l_0, 144.0, 72.0)
    H.canvas.text(P[5].k_5, 144.0, 90.0)
  end
  -- circle 4: Play
  R[5][1] = function()  -- begin
    S[5].k_1 = false
    S[5].k_0 = 1.0
    S[5].k_2 = 0.0
    S[5].k_3 = 0.0
    S[5].k_5 = ""
    S[5].k_4 = false
    S[5].k_11 = (H.storage.get("auto") == "1")
    R[3][2]()
    R[3][9](1.0)
    while (not S[5].k_1) do
      WAIT_UNTIL(function() return ((S[5].k_1 or (S[5].k_0 == 2.0)) or S[5].k_11) end, "/circles/4/rites/0/steps/9/steps/0")
      if ((not S[5].k_1) and (S[5].k_0 == 1.0)) then
        R[5][12]()
        if STOP(5) then return end
      end
      if ((not S[5].k_1) and (S[5].k_0 == 2.0)) then
        R[5][2]()
        if STOP(5) then return end
      end
    end
    FINISH(5)
    do return end
  end
  R[5][2] = function()  -- aiTurn
    local l_0 = ""
    local r_1 = R[5][6]()
    if STOP(5) then return end
    l_0 = r_1
    R[5][3](l_0)
    if STOP(5) then return end
    WAIT_UNTIL(function() return ((S[5].k_8 > 0.0) or (S[5].k_9 >= 60.0)) end, "/circles/4/rites/1/steps/3")
    S[5].k_4 = false
    local l_1 = (-1.0)
    if (S[5].k_8 > 0.0) then
      local r_2 = R[5][8](S[5].k_7)
      if STOP(5) then return end
      l_1 = r_2
    end
    R[5][4](l_1)
    if STOP(5) then return end
    R[5][5]()
    if STOP(5) then return end
  end
  R[5][3] = function(l_0)  -- ask
    S[5].k_8 = 0.0
    S[5].k_9 = 0.0
    S[5].k_4 = true
    local r_1 = ASK(5, "rival", "/circles/4/sigils/2", l_0)
    S[5].k_6 = r_1
  end
  R[5][4] = function(l_0)  -- aiMove
    local l_1 = false
    if (l_0 >= 0.0) then
      local r_1 = R[3][5]((l_0 % 8.0), F.floor((l_0 / 8.0)), 2.0)
      l_1 = r_1
    end
    if l_1 then
      R[3][7]((l_0 % 8.0), F.floor((l_0 / 8.0)), 2.0)
      S[5].k_2 = (S[5].k_2 + 1.0)
    else
      R[3][10](2.0)
      S[5].k_3 = (S[5].k_3 + 1.0)
    end
    S[5].k_5 = ""
  end
  R[5][5] = function()  -- endTurn
    local l_0 = (3.0 - S[5].k_0)
    local l_1 = false
    local r_1 = R[3][8](l_0)
    l_1 = r_1
    if l_1 then
      S[5].k_0 = l_0
    else
      local l_2 = false
      local r_2 = R[3][8](S[5].k_0)
      l_2 = r_2
      if l_2 then
        S[5].k_5 = "PASS"
      else
        S[5].k_1 = true
      end
    end
    if S[5].k_1 then
      R[3][9](0.0)
    else
      R[3][9](S[5].k_0)
    end
  end
  R[5][6] = function()  -- buildPrompt
    local l_0 = "You are O in Othello (Reversi). X is your opponent. Board: columns a-h from left, rows 1-8 from top. . is empty.\010"
    do
      local n_1 = math.floor(8.0)
      for i_2 = 0, n_1 - 1 do
        local l_1 = i_2 + 0.0
        local l_2 = ""
        do
          local n_3 = math.floor(8.0)
          for i_4 = 0, n_3 - 1 do
            local l_3 = i_4 + 0.0
            local l_4 = AT(P[3].k_0, ((l_1 * 8.0) + l_3))
            if (l_4 == 0.0) then
              l_2 = (l_2 .. ".")
            end
            if (l_4 == 1.0) then
              l_2 = (l_2 .. "X")
            end
            if (l_4 == 2.0) then
              l_2 = (l_2 .. "O")
            end
          end
        end
        l_0 = ((((l_0 .. l_2) .. " ") .. F.str((l_1 + 1.0))) .. "\010")
      end
    end
    local l_5 = ""
    local r_5 = R[3][11](2.0)
    l_5 = r_5
    l_0 = (((l_0 .. "Your legal moves: ") .. l_5) .. "\010Reply with exactly one move like d3 and nothing else.")
    do return l_0 end
  end
  R[5][7] = function(l_0)  -- letterIndex
    do
      local n_1 = math.floor(8.0)
      for i_2 = 0, n_1 - 1 do
        local l_1 = i_2 + 0.0
        if ((l_0 == F.sub("abcdefgh", l_1, 1.0)) or (l_0 == F.sub("ABCDEFGH", l_1, 1.0))) then
          do return l_1 end
        end
      end
    end
    do return (-1.0) end
  end
  R[5][8] = function(l_0)  -- parseMove
    local l_1 = F.len(l_0)
    do
      local n_1 = math.floor(F.max(0.0, (l_1 - 1.0)))
      for i_2 = 0, n_1 - 1 do
        local l_2 = i_2 + 0.0
        local l_3 = F.sub(l_0, l_2, 1.0)
        local l_4 = F.num(F.sub(l_0, (l_2 + 1.0), 1.0))
        local l_5 = (-1.0)
        local r_3 = R[5][7](l_3)
        if STOP(5) then return end
        l_5 = r_3
        if (((l_5 >= 0.0) and (l_4 >= 1.0)) and (l_4 <= 8.0)) then
          do return (((l_4 - 1.0) * 8.0) + l_5) end
        end
      end
    end
    do return (-1.0) end
  end
  R[5][9] = function(l_0, l_1, l_2)  -- recv
    if ((l_0 == "rival") and (l_1 == S[5].k_6)) then
      S[5].k_7 = l_2
      S[5].k_8 = (S[5].k_8 + 1.0)
    end
  end
  R[5][10] = function(l_0)  -- click
    local l_1 = (l_0.f_2 and (not S[5].k_10))
    S[5].k_10 = l_0.f_2
    if ((((not l_1) or (S[5].k_0 ~= 1.0)) or S[5].k_1) or S[5].k_4) then
      do return end
    end
    local l_2 = F.floor(((l_0.f_0 - 8.0) / 16.0))
    local l_3 = F.floor(((l_0.f_1 - 8.0) / 16.0))
    local l_4 = false
    local r_1 = R[3][5](l_2, l_3, 1.0)
    l_4 = r_1
    if l_4 then
      R[3][7](l_2, l_3, 1.0)
      S[5].k_5 = ""
      R[5][5]()
      if STOP(5) then return end
    end
  end
  R[5][11] = function()  -- frame
    if S[5].k_4 then
      S[5].k_9 = (S[5].k_9 + 1.0)
    end
    R[4][2]()
  end
  R[5][12] = function()  -- autoTurn
    R[3][10](1.0)
    S[5].k_5 = ""
    R[5][5]()
    if STOP(5) then return end
  end
  -- circle 5: Result
  R[6][1] = function()  -- show
    S[6].k_0 = false
    WAIT_TICKS(20.0, "/circles/5/rites/0/steps/1")
  end
  R[6][2] = function()  -- menu
    H.canvas.clear("#1b1f24")
    H.canvas.ink("#3a4250")
    do
      local n_1 = math.floor(64.0)
      for i_2 = 0, n_1 - 1 do
        local l_0 = i_2 + 0.0
        if (AT(P[3].k_0, l_0) ~= 0.0) then
          H.canvas.circle((16.0 + ((l_0 % 8.0) * 16.0)), (16.0 + (F.floor((l_0 / 8.0)) * 16.0)), 6.0)
        end
      end
    end
    R[6][3]()
    if STOP(6) then return end
    if H.ui.button("RETRY", 144.0, 112.0, 64.0, 20.0) then
      FINISH(6)
      do return end
    end
    if H.ui.button("QUIT", 144.0, 140.0, 64.0, 20.0) then
      S[6].k_0 = true
      FINISH(6)
      do return end
    end
  end
  R[6][3] = function()  -- scores
    H.canvas.ink("#c8d0dc")
    H.canvas.text("GAME OVER", 144.0, 8.0)
    H.canvas.text("BLACK X", 144.0, 28.0)
    H.canvas.text(F.str(P[3].k_2), 144.0, 38.0)
    H.canvas.text("WHITE O", 144.0, 56.0)
    H.canvas.text(F.str(P[3].k_3), 144.0, 66.0)
    local l_0 = "DRAW"
    if (P[3].k_2 > P[3].k_3) then
      l_0 = "YOU WIN"
    end
    if (P[3].k_3 > P[3].k_2) then
      l_0 = "AI WINS"
    end
    H.canvas.text(l_0, 144.0, 84.0)
  end
  CIRCLES[1] = { name = "Game", flow = "loop", children = { 2, 6 }, exit = function() return P[6].k_0 end }
  CIRCLES[2] = { name = "Round", flow = "parallel", children = { 3, 4, 5 }, exit = nil }
  CIRCLES[3] = {
    name = "Board",
    init = function() return { k_0 = {  }, k_1 = {  }, k_2 = 0.0, k_3 = 0.0, k_4 = (-1.0), k_5 = { (-1.0), (-1.0), 0.0, (-1.0), 1.0, (-1.0), (-1.0), 0.0, 1.0, 0.0, (-1.0), 1.0, 0.0, 1.0, 1.0, 1.0 }, k_6 = "abcdefgh" } end,
    publish = function() P[3].k_0 = S[3].k_0 P[3].k_1 = S[3].k_1 P[3].k_2 = S[3].k_2 P[3].k_3 = S[3].k_3 P[3].k_4 = S[3].k_4 end,
    pub = function() return '"Board.board":' .. JL(JV)(P[3].k_0) .. ',' .. '"Board.hints":' .. JL(JV)(P[3].k_1) .. ',' .. '"Board.black":' .. JV(P[3].k_2) .. ',' .. '"Board.white":' .. JV(P[3].k_3) .. ',' .. '"Board.lastMove":' .. JV(P[3].k_4) end,
    core = R[3][1], core_waits = true,
  }
  CIRCLES[4] = {
    name = "View",
    init = function() return {  } end,
    core = R[4][1], core_waits = true,
  }
  CIRCLES[5] = {
    name = "Play",
    init = function() return { k_0 = 1.0, k_1 = false, k_2 = 0.0, k_3 = 0.0, k_4 = false, k_5 = "", k_6 = 0.0, k_7 = "", k_8 = 0.0, k_9 = 0.0, k_10 = false, k_11 = false } end,
    publish = function() P[5].k_0 = S[5].k_0 P[5].k_1 = S[5].k_1 P[5].k_2 = S[5].k_2 P[5].k_3 = S[5].k_3 P[5].k_4 = S[5].k_4 P[5].k_5 = S[5].k_5 end,
    pub = function() return '"Play.turn":' .. JV(P[5].k_0) .. ',' .. '"Play.over":' .. JV(P[5].k_1) .. ',' .. '"Play.llmMoves":' .. JV(P[5].k_2) .. ',' .. '"Play.fallbackMoves":' .. JV(P[5].k_3) .. ',' .. '"Play.thinking":' .. JV(P[5].k_4) .. ',' .. '"Play.status":' .. JV(P[5].k_5) end,
    core = R[5][1], core_waits = true,
    on = { tick = R[5][11], pointer = R[5][10], message = R[5][9] },
    on_waits = { tick = false, pointer = false, message = false },
    on_ptr = { tick = "/circles/4/boundary/on/0", pointer = "/circles/4/boundary/on/1", message = "/circles/4/boundary/on/2" },
  }
  CIRCLES[6] = {
