        if (((l_5 >= 0.0) and (l_4 >= 1.0)) and (l_4 <= 8.0)) then
          local r_5 = (((l_4 - 1.0) * 8.0) + l_5)
          TRET(rr_, JV(r_5))
          do return r_5 end
