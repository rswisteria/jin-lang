    publish = function() P[5].k_0 = S[5].k_0 P[5].k_1 = S[5].k_1 P[5].k_2 = S[5].k_2 P[5].k_3 = S[5].k_3 P[5].k_4 = S[5].k_4 P[5].k_5 = S[5].k_5 end,
    pub = function() return '"Play.turn":' .. JV(P[5].k_0) .. ',' .. '"Play.over":' .. JV(P[5].k_1) .. ',' .. '"Play.llmMoves":' .. JV(P[5].k_2) .. ',' .. '"Play.fallbackMoves":' .. JV(P[5].k_3) .. ',' .. '"Play.thinking":' .. JV(P[5].k_4) .. ',' .. '"Play.status":' .. JV(P[5].k_5) end,
    dump = function() return '{' .. '"turn":' .. JV(S[5].k_0) .. ',' .. '"over":' .. JV(S[5].k_1) .. ',' .. '"llmMoves":' .. JV(S[5].k_2) .. ',' .. '"fallbackMoves":' .. JV(S[5].k_3) .. ',' .. '"thinking":' .. JV(S[5].k_4) .. ',' .. '"status":' .. JV(S[5].k_5) .. ',' .. '"pending":' .. JV(S[5].k_6) .. ',' .. '"reply":' .. JV(S[5].k_7) .. ',' .. '"replied":' .. JV(S[5].k_8) .. ',' .. '"waited":' .. JV(S[5].k_9) .. ',' .. '"pressed":' .. JV(S[5].k_10) .. ',' .. '"auto":' .. JV(S[5].k_11) .. '}' end,
    restore = function(v) do local x = RN(v["turn"]) if x ~= nil then S[5].k_0 = x end end do local x = RB(v["over"]) if x ~= nil then S[5].k_1 = x end end do local x = RN(v["llmMoves"]) if x ~= nil then S[5].k_2 = x end end do local x = RN(v["fallbackMoves"]) if x ~= nil then S[5].k_3 = x end end do local x = RB(v["thinking"]) if x ~= nil then S[5].k_4 = x end end do local x = RSTR(v["status"]) if x ~= nil then S[5].k_5 = x end end do local x = RN(v["pending"]) if x ~= nil then S[5].k_6 = x end end do local x = RSTR(v["reply"]) if x ~= nil then S[5].k_7 = x end end do local x = RN(v["replied"]) if x ~= nil then S[5].k_8 = x end end do local x = RN(v["waited"]) if x ~= nil then S[5].k_9 = x end end do local x = RB(v["pressed"]) if x ~= nil then S[5].k_10 = x end end do local x = RB(v["auto"]) if x ~= nil then S[5].k_11 = x end end end,
    prestore = function(v) do local x = RN(v["turn"]) if x ~= nil then P[5].k_0 = x end end do local x = RB(v["over"]) if x ~= nil then P[5].k_1 = x end end do local x = RN(v["llmMoves"]) if x ~= nil then P[5].k_2 = x end end do local x = RN(v["fallbackMoves"]) if x ~= nil then P[5].k_3 = x end end do local x = RB(v["thinking"]) if x ~= nil then P[5].k_4 = x end end do local x = RSTR(v["status"]) if x ~= nil then P[5].k_5 = x end end end,
    pdump = function() return '{' .. '"turn":' .. JV(P[5].k_0) .. ',' .. '"over":' .. JV(P[5].k_1) .. ',' .. '"llmMoves":' .. JV(P[5].k_2) .. ',' .. '"fallbackMoves":' .. JV(P[5].k_3) .. ',' .. '"thinking":' .. JV(P[5].k_4) .. ',' .. '"status":' .. JV(P[5].k_5) .. '}' end,
    core = R[5][1], core_waits = true,
    on = { tick = R[5][11], pointer = R[5][10], message = R[5][9] },
    on_waits = { tick = false, pointer = false, message = false },
    on_ptr = { tick = "/circles/4/boundary/on/0", pointer = "/circles/4/boundary/on/1", message = "/circles/4/boundary/on/2" },
    guards = {
      { fn = function() return ((S[5].k_2 >= 0.0) and (S[5].k_3 >= 0.0)) end, message = "手数は負にならない", pointer = "/circles/4/boundary/guards/0" },
    },
  }
  CIRCLES[6] = {
    name = "Result",
    init = function() return { k_0 = false } end,
    publish = function() P[6].k_0 = S[6].k_0 end,
    pub = function() return '"Result.quit":' .. JV(P[6].k_0) end,
    dump = function() return '{' .. '"quit":' .. JV(S[6].k_0) .. '}' end,
    restore = function(v) do local x = RB(v["quit"]) if x ~= nil then S[6].k_0 = x end end end,
    prestore = function(v) do local x = RB(v["quit"]) if x ~= nil then P[6].k_0 = x end end end,
    pdump = function() return '{' .. '"quit":' .. JV(P[6].k_0) .. '}' end,
    core = R[6][1], core_waits = true,
    on = { tick = R[6][2] },
    on_waits = { tick = false },
    on_ptr = { tick = "/circles/5/boundary/on/0" },
  }
  return { boot = boot, tick = tick }
  
  '''
# ---
# name: test_program_snapshot[debug-paddle]
  '''
  DEBUG = true
  ROOT = 1
  FPS = 60.0
  JF[0] = function(v) return '{' .. '"x":' .. JV(v.f_0) .. ',' .. '"y":' .. JV(v.f_1) .. ',' .. '"down":' .. JV(v.f_2) .. '}' end  -- Pointer
  JR[0] = function(v) if RREC(v) == nil then return nil end local f_0 = RN(v["x"]) local f_1 = RN(v["y"]) local f_2 = RB(v["down"]) if f_0 == nil or f_1 == nil or f_2 == nil then return nil end return { f_0 = f_0, f_1 = f_1, f_2 = f_2 } end  -- Pointer
  JF[1] = function(v) return '{' .. '"x":' .. JV(v.f_0) .. ',' .. '"y":' .. JV(v.f_1) .. ',' .. '"vx":' .. JV(v.f_2) .. ',' .. '"vy":' .. JV(v.f_3) .. '}' end  -- Ball
  JR[1] = function(v) if RREC(v) == nil then return nil end local f_0 = RN(v["x"]) local f_1 = RN(v["y"]) local f_2 = RN(v["vx"]) local f_3 = RN(v["vy"]) if f_0 == nil or f_1 == nil or f_2 == nil or f_3 == nil then return nil end return { f_0 = f_0, f_1 = f_1, f_2 = f_2, f_3 = f_3 } end  -- Ball
  R[2] = {}
  R[3] = {}
  -- circle 1: Play
  R[2][1] = function()  -- begin
    local rr_ = TR(2, "begin", "/circles/1/rites/0", '[]')
    S[2].k_2 = 0.0
    TS(2, "score", "/circles/1/rites/0/steps/0", JV(S[2].k_2))
    do
      R[2][2]()
      if STOP(2) then return end
    end
  end
  R[2][2] = function()  -- serve
    local rr_ = TR(2, "serve", "/circles/1/rites/1", '[]')
    S[2].k_0 = { f_0 = 160.0, f_1 = 40.0, f_2 = 90.0, f_3 = 70.0 }
    TS(2, "ball", "/circles/1/rites/1/steps/0", JF[1](S[2].k_0))
  end
  R[2][3] = function(l_0)  -- step
    local rr_ = TR(2, "step", "/circles/1/rites/2", '[' .. JV(l_0) .. ']')
    if H.input.key("ArrowLeft") then
      S[2].k_1 = F.max(0.0, (S[2].k_1 - (180.0 * l_0)))
      TS(2, "paddle", "/circles/1/rites/2/steps/0/then/0", JV(S[2].k_1))
    end
    if H.input.key("ArrowRight") then
      S[2].k_1 = F.min(280.0, (S[2].k_1 + (180.0 * l_0)))
      TS(2, "paddle", "/circles/1/rites/2/steps/1/then/0", JV(S[2].k_1))
    end
    S[2].k_0.f_0 = (S[2].k_0.f_0 + (S[2].k_0.f_2 * l_0))
    TS(2, "ball", "/circles/1/rites/2/steps/2", JF[1](S[2].k_0))
    S[2].k_0.f_1 = (S[2].k_0.f_1 + (S[2].k_0.f_3 * l_0))
    TS(2, "ball", "/circles/1/rites/2/steps/3", JF[1](S[2].k_0))
    if ((S[2].k_0.f_0 < 0.0) or (S[2].k_0.f_0 > 320.0)) then
      S[2].k_0.f_2 = (-S[2].k_0.f_2)
      TS(2, "ball", "/circles/1/rites/2/steps/4/then/0", JF[1](S[2].k_0))
    end
    if (S[2].k_0.f_1 < 0.0) then
      S[2].k_0.f_3 = (-S[2].k_0.f_3)
      TS(2, "ball", "/circles/1/rites/2/steps/5/then/0", JF[1](S[2].k_0))
    end
    if (((S[2].k_0.f_1 > 170.0) and (S[2].k_0.f_0 >= S[2].k_1)) and (S[2].k_0.f_0 <= (S[2].k_1 + 40.0))) then
      S[2].k_0.f_3 = ((-F.abs(S[2].k_0.f_3)) * 1.05)
      TS(2, "ball", "/circles/1/rites/2/steps/6/then/0", JF[1](S[2].k_0))
      S[2].k_2 = (S[2].k_2 + 1.0)
      TS(2, "score", "/circles/1/rites/2/steps/6/then/1", JV(S[2].k_2))
      do
        local a_1, a_2 = 440.0, 50.0
        local c_3 = T("cast", 2, "audio.tone", "/circles/1/rites/2/steps/6/then/2", '[' .. JV(a_1) .. ',' .. JV(a_2) .. ']', nil)
        H.audio.tone(a_1, a_2)
      end
    end
    if (S[2].k_0.f_1 > 180.0) then
      T("finish", 2, nil, "/circles/1/rites/2/steps/7/then/0", nil, nil)
      FINISH(2)
      do return end
    end
    do
      R[2][4]()
      if STOP(2) then return end
    end
  end
  R[2][4] = function()  -- paint
    local rr_ = TR(2, "paint", "/circles/1/rites/3", '[]')
    do
      local a_1 = "#000"
      local c_2 = T("cast", 2, "canvas.clear", "/circles/1/rites/3/steps/0", '[' .. JV(a_1) .. ']', nil)
      H.canvas.clear(a_1)
    end
    do
      local a_3 = "#fff"
      local c_4 = T("cast", 2, "canvas.ink", "/circles/1/rites/3/steps/1", '[' .. JV(a_3) .. ']', nil)
      H.canvas.ink(a_3)
    end
    do
      local a_5, a_6, a_7, a_8 = S[2].k_1, 172.0, 40.0, 4.0
      local c_9 = T("cast", 2, "canvas.rect", "/circles/1/rites/3/steps/2", '[' .. JV(a_5) .. ',' .. JV(a_6) .. ',' .. JV(a_7) .. ',' .. JV(a_8) .. ']', nil)
      H.canvas.rect(a_5, a_6, a_7, a_8)
    end
    do
      local a_10, a_11, a_12 = S[2].k_0.f_0, S[2].k_0.f_1, 3.0
      local c_13 = T("cast", 2, "canvas.circle", "/circles/1/rites/3/steps/3", '[' .. JV(a_10) .. ',' .. JV(a_11) .. ',' .. JV(a_12) .. ']', nil)
      H.canvas.circle(a_10, a_11, a_12)
    end
    do
      local a_14, a_15, a_16 = ("SCORE " .. F.str(S[2].k_2)), 4.0, 4.0
      local c_17 = T("cast", 2, "canvas.text", "/circles/1/rites/3/steps/4", '[' .. JV(a_14) .. ',' .. JV(a_15) .. ',' .. JV(a_16) .. ']', nil)
      H.canvas.text(a_14, a_15, a_16)
    end
  end
  -- circle 2: Result
  R[3][1] = function()  -- show
    local rr_ = TR(3, "show", "/circles/2/rites/0", '[]')
    S[3].k_0 = false
    TS(3, "quit", "/circles/2/rites/0/steps/0", JV(S[3].k_0))
    WAIT_TICKS(20.0, "/circles/2/rites/0/steps/1")
  end
  R[3][2] = function()  -- menu
    local rr_ = TR(3, "menu", "/circles/2/rites/1", '[]')
    do
      local a_1 = "#000"
      local c_2 = T("cast", 3, "canvas.clear", "/circles/2/rites/1/steps/0", '[' .. JV(a_1) .. ']', nil)
      H.canvas.clear(a_1)
    end
    do
      local a_3, a_4, a_5 = ("SCORE " .. F.str(P[2].k_2)), 120.0, 60.0
      local c_6 = T("cast", 3, "canvas.text", "/circles/2/rites/1/steps/1", '[' .. JV(a_3) .. ',' .. JV(a_4) .. ',' .. JV(a_5) .. ']', nil)
      H.canvas.text(a_3, a_4, a_5)
    end
    if H.ui.button("RETRY", 120.0, 100.0, 80.0, 24.0) then
      T("finish", 3, nil, "/circles/2/rites/1/steps/2/then/0", nil, nil)
      FINISH(3)
      do return end
    end
    if H.ui.button("QUIT", 120.0, 130.0, 80.0, 24.0) then
      S[3].k_0 = true
      TS(3, "quit", "/circles/2/rites/1/steps/3/then/0", JV(S[3].k_0))
      T("finish", 3, nil, "/circles/2/rites/1/steps/3/then/1", nil, nil)
      FINISH(3)
      do return end
    end
  end
  CIRCLES[1] = { name = "Game", flow = "loop", children = { 2, 3 }, exit = function() return P[3].k_0 end }
  CIRCLES[2] = {
    name = "Play",
    init = function() return { k_0 = { f_0 = 160.0, f_1 = 40.0, f_2 = 90.0, f_3 = 70.0 }, k_1 = 140.0, k_2 = 0.0 } end,
    publish = function() P[2].k_2 = S[2].k_2 end,
    pub = function() return '"Play.score":' .. JV(P[2].k_2) end,
    dump = function() return '{' .. '"ball":' .. JF[1](S[2].k_0) .. ',' .. '"paddle":' .. JV(S[2].k_1) .. ',' .. '"score":' .. JV(S[2].k_2) .. '}' end,
    restore = function(v) do local x = JR[1](v["ball"]) if x ~= nil then S[2].k_0 = x end end do local x = RN(v["paddle"]) if x ~= nil then S[2].k_1 = x end end do local x = RN(v["score"]) if x ~= nil then S[2].k_2 = x end end end,
    prestore = function(v) do local x = RN(v["score"]) if x ~= nil then P[2].k_2 = x end end end,
    pdump = function() return '{' .. '"score":' .. JV(P[2].k_2) .. '}' end,
    core = R[2][1], core_waits = false,
    on = { tick = R[2][3] },
    on_waits = { tick = false },
    on_ptr = { tick = "/circles/1/boundary/on/0" },
    guards = {
      { fn = function() return (S[2].k_2 >= 0.0) end, message = "score は負にならない", pointer = "/circles/1/boundary/guards/0" },
    },
  }
  CIRCLES[3] = {
    name = "Result",
    init = function() return { k_0 = false } end,
    publish = function() P[3].k_0 = S[3].k_0 end,
    pub = function() return '"Result.quit":' .. JV(P[3].k_0) end,
    dump = function() return '{' .. '"quit":' .. JV(S[3].k_0) .. '}' end,
    restore = function(v) do local x = RB(v["quit"]) if x ~= nil then S[3].k_0 = x end end end,
    prestore = function(v) do local x = RB(v["quit"]) if x ~= nil then P[3].k_0 = x end end end,
    pdump = function() return '{' .. '"quit":' .. JV(P[3].k_0) .. '}' end,
    core = R[3][1], core_waits = true,
    on = { tick = R[3][2] },
    on_waits = { tick = false },
    on_ptr = { tick = "/circles/2/boundary/on/0" },
  }
  return { boot = boot, tick = tick }
  
  '''
# ---
# name: test_program_snapshot[debug-tetris]
  '''
  DEBUG = true
  ROOT = 1
  FPS = 30.0
  JF[0] = function(v) return '{' .. '"x":' .. JV(v.f_0) .. ',' .. '"y":' .. JV(v.f_1) .. ',' .. '"down":' .. JV(v.f_2) .. '}' end  -- Pointer
  JR[0] = function(v) if RREC(v) == nil then return nil end local f_0 = RN(v["x"]) local f_1 = RN(v["y"]) local f_2 = RB(v["down"]) if f_0 == nil or f_1 == nil or f_2 == nil then return nil end return { f_0 = f_0, f_1 = f_1, f_2 = f_2 } end  -- Pointer
  JF[1] = function(v) return '{' .. '"kind":' .. JV(v.f_0) .. ',' .. '"rot":' .. JV(v.f_1) .. ',' .. '"x":' .. JV(v.f_2) .. ',' .. '"y":' .. JV(v.f_3) .. '}' end  -- Piece
  JR[1] = function(v) if RREC(v) == nil then return nil end local f_0 = RN(v["kind"]) local f_1 = RN(v["rot"]) local f_2 = RN(v["x"]) local f_3 = RN(v["y"]) if f_0 == nil or f_1 == nil or f_2 == nil or f_3 == nil then return nil end return { f_0 = f_0, f_1 = f_1, f_2 = f_2, f_3 = f_3 } end  -- Piece
  R[2] = {}
  R[3] = {}
  -- circle 1: Play
  R[2][1] = function()  -- begin
    local rr_ = TR(2, "begin", "/circles/1/rites/0", '[]')
    S[2].k_3 = 0.0
    TS(2, "score", "/circles/1/rites/0/steps/0", JV(S[2].k_3))
    S[2].k_4 = 0.0
    TS(2, "lines", "/circles/1/rites/0/steps/1", JV(S[2].k_4))
    S[2].k_5 = 0.0
    TS(2, "placed", "/circles/1/rites/0/steps/2", JV(S[2].k_5))
    S[2].k_6 = 15.0
    TS(2, "speed", "/circles/1/rites/0/steps/3", JV(S[2].k_6))
    S[2].k_8 = false
    TS(2, "over", "/circles/1/rites/0/steps/4", JV(S[2].k_8))
    S[2].k_7 = 0.0
    TS(2, "soft", "/circles/1/rites/0/steps/5", JV(S[2].k_7))
    do
      local a_1 = S[2].k_0
      local c_2 = T("cast", 2, "clear", "/circles/1/rites/0/steps/6", '[' .. JL(JV)(a_1) .. ']', nil)
      E.clear(a_1)
    end
    do
      local n_3 = math.floor(200.0)
      for i_4 = 0, n_3 - 1 do
        local l_0 = i_4 + 0.0
        do
          local a_5, a_6 = S[2].k_0, 0.0
          local c_7 = T("cast", 2, "push", "/circles/1/rites/0/steps/7/steps/0", '[' .. JL(JV)(a_5) .. ',' .. JV(a_6) .. ']', nil)
          E.push(a_5, a_6)
        end
      end
    end
    S[2].k_2 = H.random.range(0.0, 6.0)
    TS(2, "next", "/circles/1/rites/0/steps/8", JV(S[2].k_2))
    do
      R[2][3]()
      if STOP(2) then return end
    end
    while (not S[2].k_8) do
      WAIT_TICKS(S[2].k_6, "/circles/1/rites/0/steps/10/steps/0")
      local l_1 = false
      do
        local a_8, a_9, a_10, a_11 = S[2].k_1.f_0, S[2].k_1.f_1, S[2].k_1.f_2, (S[2].k_1.f_3 + 1.0)
        local r_12 = R[2][2](a_8, a_9, a_10, a_11)
        if STOP(2) then return end
        l_1 = r_12
      end
      if l_1 then
        S[2].k_1.f_3 = (S[2].k_1.f_3 + 1.0)
        TS(2, "piece", "/circles/1/rites/0/steps/10/steps/3/then/0", JF[1](S[2].k_1))
      else
        do
          R[2][4]()
          if STOP(2) then return end
        end
      end
    end
    T("finish", 2, nil, "/circles/1/rites/0/steps/11", nil, nil)
    FINISH(2)
    do return end
  end
  R[2][2] = function(l_0, l_1, l_2, l_3)  -- fits
    local rr_ = TR(2, "fits", "/circles/1/rites/1", '[' .. JV(l_0) .. ',' .. JV(l_1) .. ',' .. JV(l_2) .. ',' .. JV(l_3) .. ']')
    do
      local n_1 = math.floor(4.0)
      for i_2 = 0, n_1 - 1 do
        local l_4 = i_2 + 0.0
        local l_5 = (l_2 + AT(S[2].k_9, (((((l_0 * 4.0) + l_1) * 4.0) + l_4) * 2.0)))
        local l_6 = (l_3 + AT(S[2].k_9, ((((((l_0 * 4.0) + l_1) * 4.0) + l_4) * 2.0) + 1.0)))
        if (((l_5 < 0.0) or (l_5 >= 10.0)) or (l_6 >= 20.0)) then
          local r_3 = false
          TRET(rr_, JV(r_3))
          do return r_3 end
        end
        if ((l_6 >= 0.0) and (AT(S[2].k_0, ((l_6 * 10.0) + l_5)) ~= 0.0)) then
          local r_4 = false
          TRET(rr_, JV(r_4))
          do return r_4 end
        end
      end
    end
    local r_5 = true
    TRET(rr_, JV(r_5))
    do return r_5 end
  end
  R[2][3] = function()  -- spawn
    local rr_ = TR(2, "spawn", "/circles/1/rites/2", '[]')
    S[2].k_1 = { f_0 = S[2].k_2, f_1 = 0.0, f_2 = 3.0, f_3 = 0.0 }
    TS(2, "piece", "/circles/1/rites/2/steps/0", JF[1](S[2].k_1))
    S[2].k_2 = H.random.range(0.0, 6.0)
    TS(2, "next", "/circles/1/rites/2/steps/1", JV(S[2].k_2))
    local l_0 = false
    do
      local a_1, a_2, a_3, a_4 = S[2].k_1.f_0, S[2].k_1.f_1, S[2].k_1.f_2, S[2].k_1.f_3
      local r_5 = R[2][2](a_1, a_2, a_3, a_4)
      if STOP(2) then return end
      l_0 = r_5
    end
    if (not l_0) then
      S[2].k_8 = true
      TS(2, "over", "/circles/1/rites/2/steps/4/then/0", JV(S[2].k_8))
    end
  end
  R[2][4] = function()  -- lock
    local rr_ = TR(2, "lock", "/circles/1/rites/3", '[]')
    local l_0 = S[2].k_1.f_0
    local l_1 = S[2].k_1.f_1
    do
      local n_1 = math.floor(4.0)
      for i_2 = 0, n_1 - 1 do
        local l_2 = i_2 + 0.0
