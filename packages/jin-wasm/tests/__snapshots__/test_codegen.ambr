# ---
# name: test_program_snapshot[debug-clicker]
  '''
  DEBUG = true
  ROOT = 1
  FPS = 60.0
  JF[0] = function(v) return '{' .. '"x":' .. JV(v.f_0) .. ',' .. '"y":' .. JV(v.f_1) .. ',' .. '"down":' .. JV(v.f_2) .. '}' end  -- Pointer
  JR[0] = function(v) if RREC(v) == nil then return nil end local f_0 = RN(v["x"]) local f_1 = RN(v["y"]) local f_2 = RB(v["down"]) if f_0 == nil or f_1 == nil or f_2 == nil then return nil end return { f_0 = f_0, f_1 = f_1, f_2 = f_2 } end  -- Pointer
  R[1] = {}
  -- circle 0: Clicker
  R[1][1] = function()  -- grow
    local rr_ = TR(1, "grow", "/circles/0/rites/0", '[]')
    while true do
      WAIT_TICKS(60.0, "/circles/0/rites/0/steps/0/steps/0")
      S[1].k_0 = (S[1].k_0 + S[1].k_1)
      TS(1, "count", "/circles/0/rites/0/steps/0/steps/1", JV(S[1].k_0))
      if (H.random.next() < 0.1) then
        S[1].k_2 = "LUCKY +10"
        TS(1, "bonus", "/circles/0/rites/0/steps/0/steps/2/then/0", JV(S[1].k_2))
        S[1].k_0 = (S[1].k_0 + 10.0)
        TS(1, "count", "/circles/0/rites/0/steps/0/steps/2/then/1", JV(S[1].k_0))
      else
        S[1].k_2 = ""
        TS(1, "bonus", "/circles/0/rites/0/steps/0/steps/2/else/0", JV(S[1].k_2))
      end
    end
  end
  R[1][2] = function()  -- screen
    local rr_ = TR(1, "screen", "/circles/0/rites/1", '[]')
    do
      local a_1 = "#123"
      local c_2 = T("cast", 1, "canvas.clear", "/circles/0/rites/1/steps/0", '[' .. JV(a_1) .. ']', nil)
      H.canvas.clear(a_1)
    end
    do
      local a_3, a_4, a_5 = ("COOKIES " .. F.str(S[1].k_0)), 8.0, 8.0
      local c_6 = T("cast", 1, "ui.label", "/circles/0/rites/1/steps/1", '[' .. JV(a_3) .. ',' .. JV(a_4) .. ',' .. JV(a_5) .. ']', nil)
      H.ui.label(a_3, a_4, a_5)
    end
    do
      local a_7, a_8, a_9 = (("RATE " .. F.str(S[1].k_1)) .. "/s"), 8.0, 20.0
      local c_10 = T("cast", 1, "ui.label", "/circles/0/rites/1/steps/2", '[' .. JV(a_7) .. ',' .. JV(a_8) .. ',' .. JV(a_9) .. ']', nil)
      H.ui.label(a_7, a_8, a_9)
    end
    do
      local a_11, a_12, a_13 = S[1].k_2, 8.0, 32.0
      local c_14 = T("cast", 1, "ui.label", "/circles/0/rites/1/steps/3", '[' .. JV(a_11) .. ',' .. JV(a_12) .. ',' .. JV(a_13) .. ']', nil)
      H.ui.label(a_11, a_12, a_13)
    end
    if H.ui.button("CLICK", 20.0, 60.0, 90.0, 28.0) then
      S[1].k_0 = (S[1].k_0 + 1.0)
      TS(1, "count", "/circles/0/rites/1/steps/4/then/0", JV(S[1].k_0))
    end
    if (H.ui.button("UPGRADE", 130.0, 60.0, 90.0, 28.0) and (S[1].k_0 >= 10.0)) then
      S[1].k_0 = (S[1].k_0 - 10.0)
      TS(1, "count", "/circles/0/rites/1/steps/5/then/0", JV(S[1].k_0))
      S[1].k_1 = (S[1].k_1 + 1.0)
      TS(1, "rate", "/circles/0/rites/1/steps/5/then/1", JV(S[1].k_1))
    end
    if H.ui.button("DONE", 75.0, 110.0, 90.0, 28.0) then
      T("finish", 1, nil, "/circles/0/rites/1/steps/6/then/0", nil, nil)
      FINISH(1)
      do return end
    end
  end
  CIRCLES[1] = {
    name = "Clicker",
    init = function() return { k_0 = 0.0, k_1 = 0.0, k_2 = "" } end,
    publish = function() P[1].k_0 = S[1].k_0 end,
    pub = function() return '"Clicker.count":' .. JV(P[1].k_0) end,
    dump = function() return '{' .. '"count":' .. JV(S[1].k_0) .. ',' .. '"rate":' .. JV(S[1].k_1) .. ',' .. '"bonus":' .. JV(S[1].k_2) .. '}' end,
    restore = function(v) do local x = RN(v["count"]) if x ~= nil then S[1].k_0 = x end end do local x = RN(v["rate"]) if x ~= nil then S[1].k_1 = x end end do local x = RSTR(v["bonus"]) if x ~= nil then S[1].k_2 = x end end end,
    prestore = function(v) do local x = RN(v["count"]) if x ~= nil then P[1].k_0 = x end end end,
    pdump = function() return '{' .. '"count":' .. JV(P[1].k_0) .. '}' end,
    core = R[1][1], core_waits = true,
    on = { tick = R[1][2] },
    on_waits = { tick = false },
    on_ptr = { tick = "/circles/0/boundary/on/0" },
    guards = {
      { fn = function() return (S[1].k_0 >= 0.0) end, message = "count は負にならない", pointer = "/circles/0/boundary/guards/0" },
    },
  }
  return { boot = boot, tick = tick }
  
  '''
# ---
# name: test_program_snapshot[debug-fib]
  '''
  DEBUG = true
  ROOT = 1
  FPS = 60.0
  JF[0] = function(v) return '{' .. '"x":' .. JV(v.f_0) .. ',' .. '"y":' .. JV(v.f_1) .. ',' .. '"down":' .. JV(v.f_2) .. '}' end  -- Pointer
  JR[0] = function(v) if RREC(v) == nil then return nil end local f_0 = RN(v["x"]) local f_1 = RN(v["y"]) local f_2 = RB(v["down"]) if f_0 == nil or f_1 == nil or f_2 == nil then return nil end return { f_0 = f_0, f_1 = f_1, f_2 = f_2 } end  -- Pointer
  R[1] = {}
  -- circle 0: Fib
  R[1][1] = function(l_0)  -- fib
    local rr_ = TR(1, "fib", "/circles/0/rites/0", '[' .. JV(l_0) .. ']')
    local l_1 = 0.0
    local l_2 = 1.0
    do
      local n_1 = math.floor(l_0)
      for i_2 = 0, n_1 - 1 do
        local l_3 = (l_1 + l_2)
        l_1 = l_2
        l_2 = l_3
      end
    end
    local r_3 = l_1
    TRET(rr_, JV(r_3))
    do return r_3 end
  end
  R[1][2] = function()  -- main
    local rr_ = TR(1, "main", "/circles/0/rites/1", '[]')
    do
      local a_1 = 20.0
      local r_2 = R[1][1](a_1)
      if STOP(1) then return end
      S[1].k_0 = r_2
      TS(1, "answer", "/circles/0/rites/1/steps/0", JV(S[1].k_0))
    end
    T("finish", 1, nil, "/circles/0/rites/1/steps/1", nil, nil)
    FINISH(1)
    do return end
  end
  CIRCLES[1] = {
    name = "Fib",
    init = function() return { k_0 = 0.0 } end,
    publish = function() P[1].k_0 = S[1].k_0 end,
    pub = function() return '"Fib.answer":' .. JV(P[1].k_0) end,
    dump = function() return '{' .. '"answer":' .. JV(S[1].k_0) .. '}' end,
    restore = function(v) do local x = RN(v["answer"]) if x ~= nil then S[1].k_0 = x end end end,
    prestore = function(v) do local x = RN(v["answer"]) if x ~= nil then P[1].k_0 = x end end end,
    pdump = function() return '{' .. '"answer":' .. JV(P[1].k_0) .. '}' end,
    core = R[1][2], core_waits = false,
  }
  return { boot = boot, tick = tick }
  
  '''
# ---
# name: test_program_snapshot[debug-othello]
  '''
  DEBUG = true
  ROOT = 1
  FPS = 30.0
  JF[0] = function(v) return '{' .. '"x":' .. JV(v.f_0) .. ',' .. '"y":' .. JV(v.f_1) .. ',' .. '"down":' .. JV(v.f_2) .. '}' end  -- Pointer
  JR[0] = function(v) if RREC(v) == nil then return nil end local f_0 = RN(v["x"]) local f_1 = RN(v["y"]) local f_2 = RB(v["down"]) if f_0 == nil or f_1 == nil or f_2 == nil then return nil end return { f_0 = f_0, f_1 = f_1, f_2 = f_2 } end  -- Pointer
  R[3] = {}
  R[4] = {}
  R[5] = {}
  R[6] = {}
  -- circle 2: Board
  R[3][1] = function()  -- idle
    local rr_ = TR(3, "idle", "/circles/2/rites/0", '[]')
    WAIT_UNTIL(function() return P[5].k_1 end, "/circles/2/rites/0/steps/0")
    T("finish", 3, nil, "/circles/2/rites/0/steps/1", nil, nil)
    FINISH(3)
    do return end
  end
  R[3][2] = function()  -- resetBoard
    local rr_ = TR(3, "resetBoard", "/circles/2/rites/1", '[]')
    do
      local a_1 = S[3].k_0
      local c_2 = T("cast", 3, "clear", "/circles/2/rites/1/steps/0", '[' .. JL(JV)(a_1) .. ']', nil)
      E.clear(a_1)
    end
    do
      local n_3 = math.floor(64.0)
      for i_4 = 0, n_3 - 1 do
        local l_0 = i_4 + 0.0
        do
          local a_5, a_6 = S[3].k_0, 0.0
          local c_7 = T("cast", 3, "push", "/circles/2/rites/1/steps/1/steps/0", '[' .. JL(JV)(a_5) .. ',' .. JV(a_6) .. ']', nil)
          E.push(a_5, a_6)
        end
      end
    end
    SETAT(S[3].k_0, 27.0, 2.0)
    TS(3, "board", "/circles/2/rites/1/steps/2", JL(JV)(S[3].k_0))
    SETAT(S[3].k_0, 28.0, 1.0)
    TS(3, "board", "/circles/2/rites/1/steps/3", JL(JV)(S[3].k_0))
    SETAT(S[3].k_0, 35.0, 1.0)
    TS(3, "board", "/circles/2/rites/1/steps/4", JL(JV)(S[3].k_0))
    SETAT(S[3].k_0, 36.0, 2.0)
    TS(3, "board", "/circles/2/rites/1/steps/5", JL(JV)(S[3].k_0))
    S[3].k_4 = (-1.0)
    TS(3, "lastMove", "/circles/2/rites/1/steps/6", JV(S[3].k_4))
    do
      R[3][3]()
      if STOP(3) then return end
    end
  end
  R[3][3] = function()  -- count
    local rr_ = TR(3, "count", "/circles/2/rites/2", '[]')
    S[3].k_2 = 0.0
    TS(3, "black", "/circles/2/rites/2/steps/0", JV(S[3].k_2))
    S[3].k_3 = 0.0
    TS(3, "white", "/circles/2/rites/2/steps/1", JV(S[3].k_3))
    do
      local n_1 = math.floor(64.0)
      for i_2 = 0, n_1 - 1 do
        local l_0 = i_2 + 0.0
        if (AT(S[3].k_0, l_0) == 1.0) then
          S[3].k_2 = (S[3].k_2 + 1.0)
          TS(3, "black", "/circles/2/rites/2/steps/2/steps/0/then/0", JV(S[3].k_2))
        end
