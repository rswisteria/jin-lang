    prestore = function(v) do local x = RL(RN)(v["board"]) if x ~= nil then P[3].k_0 = x end end do local x = RL(RN)(v["hints"]) if x ~= nil then P[3].k_1 = x end end do local x = RN(v["black"]) if x ~= nil then P[3].k_2 = x end end do local x = RN(v["white"]) if x ~= nil then P[3].k_3 = x end end do local x = RN(v["lastMove"]) if x ~= nil then P[3].k_4 = x end end end,
