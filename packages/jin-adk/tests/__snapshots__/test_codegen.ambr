  class StateCheckAgent(BaseAgent):
      """flow.exit の判定。条件が成立したら escalate して LoopAgent を抜ける。"""
  
      state_key: str
      expected: Any
  
      async def _run_async_impl(self, ctx: InvocationContext) -> AsyncGenerator[Event, None]:
          if ctx.session.state.get(self.state_key) == self.expected:
              yield Event(author=self.name, actions=EventActions(escalate=True))
  
  
  Drafter = LlmAgent(
      name="Drafter",
      model="gemini-2.5-flash",
      instruction="下書きを書く",
      output_key="draft",
  )
  
  Reviewer = LlmAgent(
      name="Reviewer",
      model="gemini-2.5-flash",
      instruction="{draft} をレビューする",
      output_key="review",
  )
  
  Critic = LlmAgent(
      name="Critic",
      model="gemini-2.5-flash",
      instruction="{draft} を批評し、十分なら approved=true",
      output_key="approved",
  )
  
  Rewriter = LlmAgent(
      name="Rewriter",
      model="gemini-2.5-flash",
      instruction="{review} を踏まえて {draft} を書き直す",
      output_key="draft",
  )
  
  Refine = LoopAgent(
      name="Refine",
      sub_agents=[
          Critic,
          Rewriter,
          StateCheckAgent(
              name="Refine__exit",
              state_key="approved",
              expected=True,
          ),
      ],
      max_iterations=3,
  )
  
  root_agent = SequentialAgent(
      name="Pipeline",
      sub_agents=[
