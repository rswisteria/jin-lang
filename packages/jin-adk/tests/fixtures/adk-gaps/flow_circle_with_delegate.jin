{
  "$schema": "https://xtone.internal/jin/schemas/jin.schema.json",
  "version": 1,
  "root": "Flow",
  "circles": [
    {
      "name": "Flow",
      "delegate": [
        "Other"
      ],
      "flow": {
        "kind": "sequence",
        "steps": [
          "Step"
        ]
      }
    },
    {
      "name": "Step",
      "core": "gemini-2.5-flash",
      "instruction": {
        "rune": "y"
      }
    },
    {
      "name": "Other",
      "core": "gemini-2.5-flash",
      "instruction": {
        "rune": "z"
      }
    }
  ]
}
